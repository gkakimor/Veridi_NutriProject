# Copie este arquivo para .env e ajuste os valores locais.
# O .env NAO deve ser versionado.

# Banco de desenvolvimento local (PostgreSQL)
# A senha faz parte de uma URL: caracteres como @ : / ? # & % precisam ser
# percent-encoded (@ -> %40, / -> %2F). `scripts/bootstrap-local.ps1` ja faz isso.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/veridi_dev?schema=public"

# Testes da API — nunca escrevem no banco de cima.
# Sem esta linha, a suíte usa <banco da DATABASE_URL>_test no mesmo servidor
# (veridi_dev -> veridi_dev_test), criado e migrado sozinho na primeira rodada.
# Com ela (CI), o nome do banco precisa ter a palavra "test" e não pode ser o
# banco da DATABASE_URL — senão a suíte recusa antes de rodar.
# TEST_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/veridi_test?schema=public"

# API — SOMENTE DESENVOLVIMENTO.
# Nao levar para producao: 127.0.0.1 e loopback, e num container a API so
# responderia a ela mesma (health check falha). Em producao nao defina
# API_HOST; use PORT, injetada pelo provedor. Ver docs/DEPLOY.md.
API_PORT=3333
API_HOST=127.0.0.1

# Frontend (Vite) — base da API consumida pelo web
VITE_API_URL="http://127.0.0.1:3333"

# Origem do frontend aceita por CORS quando NODE_ENV=production.
# Na implantacao de origem unica isso nao e usado: front e API respondem no
# mesmo host, entao nao ha requisicao cross-origin.
WEB_ORIGIN="http://127.0.0.1:5173"

# Armazenamento do arquivo do Item Rotulo (LABEL-ATTACHMENTS-01).
# Sem estas linhas: LOCAL_FS, dentro de VERIDI_UPLOAD_DIR (padrao ../../.local-data/uploads).
# R2: bucket privado da Cloudflare pela API S3. Credencial NUNCA no Git — so no
# .env local (ignorado) ou nas Variables do Railway. Ver docs/DEPLOY.md, secao 6.1.
# Endpoint e so a conta, sem o nome do bucket no caminho.
# VERIDI_STORAGE_PROVIDER=R2
# VERIDI_R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
# VERIDI_R2_BUCKET=veridi-homologacao
# VERIDI_R2_REGION=auto
# VERIDI_R2_ACCESS_KEY_ID=
# VERIDI_R2_SECRET_ACCESS_KEY=

# Build do frontend servido pela propria API (origem unica).
# Vazio em desenvolvimento: o Vite continua servindo o front na porta dele.
# Em producao: VERIDI_WEB_DIST=apps/web/dist  (ver docs/DEPLOY.md)
VERIDI_WEB_DIST=
