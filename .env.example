# Copie este arquivo para .env e ajuste os valores locais.
# O .env NAO deve ser versionado.

# Banco de desenvolvimento local (PostgreSQL)
# A senha faz parte de uma URL: caracteres como @ : / ? # & % precisam ser
# percent-encoded (@ -> %40, / -> %2F). `scripts/bootstrap-local.ps1` ja faz isso.
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5432/veridi_dev?schema=public"

# API
API_PORT=3333
API_HOST=127.0.0.1

# Frontend (Vite) — base da API consumida pelo web
VITE_API_URL="http://127.0.0.1:3333"

# Origem do frontend aceita por CORS quando NODE_ENV=production.
# Na implantacao de origem unica isso nao e usado: front e API respondem no
# mesmo host, entao nao ha requisicao cross-origin.
WEB_ORIGIN="http://127.0.0.1:5173"

# Build do frontend servido pela propria API (origem unica).
# Vazio em desenvolvimento: o Vite continua servindo o front na porta dele.
# Em producao: VERIDI_WEB_DIST=apps/web/dist  (ver docs/DEPLOY.md)
VERIDI_WEB_DIST=
