// Veridi Nutrition — schema Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_PRODUCT
}

enum UomDimension {
  MASS
  COUNT
  VOLUME
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum LotStatus {
  AWAITING_RELEASE
  AVAILABLE
  BLOCKED
  EXPIRED
}

/// Unidades de medida do sistema. Sem tela administrativa no MVP: seed
/// controlado pelo backend (prisma/seed.ts).
///
/// `toBaseFactor` e o fator de conversao para a unidade-base da dimensao
/// (MASS -> g, VOLUME -> L, COUNT -> un), fundacao para conversao entre
/// unidades compativeis quando formulacoes existirem. Conversao entre
/// dimensoes diferentes nunca e permitida.
model UnitOfMeasure {
  code         String       @id
  label        String
  dimension    UomDimension
  toBaseFactor Decimal      @db.Decimal(18, 6)

  items Item[]

  @@map("units_of_measure")
}

/// Item controlado pela operacao (materia-prima, embalagem ou produto acabado).
/// Cadastro base: sem estoque, fornecedor, preco ou lote fisico neste momento.
model Item {
  id   String   @id @default(uuid())
  type ItemType

  /// Codigo interno gerado pelo backend (sequence dedicada por tipo,
  /// MP-000001 / ME-000001 / PA-000001). Imutavel apos a criacao.
  code String @unique

  name            String
  unitCode        String
  unit            UnitOfMeasure @relation(fields: [unitCode], references: [code])
  controlsLot     Boolean       @default(true)
  controlsExpiry  Boolean       @default(true)

  /// Se um lote recebido deste item fica AWAITING_RELEASE (precisa
  /// liberacao da Qualidade) ou ja nasce AVAILABLE. Default por tipo
  /// (ITEM_TYPE_DEFAULTS em @veridi/shared), editavel pelo usuario — nao
  /// inferido permanentemente so pelo type.
  requiresQualityRelease Boolean @default(true)

  externalBarcode String?
  active          Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Produto que usa este item (type = FINISHED_PRODUCT) como saida
  /// fisica. 1:1 no MVP — ver Product.finishedProductItemId.
  product Product?

  purchaseOrderLines PurchaseOrderLine[]
  receiptLines        ReceiptLine[]
  lots                Lot[]

  @@index([type])
  @@index([active])
  @@index([externalBarcode])
  @@map("items")
}

/// Fornecedor. Cadastro base: sem preco, avaliacao, dados bancarios ou
/// vinculo com Item neste momento (entra em Compras/Recebimento).
model Supplier {
  id   String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, FOR-000001).
  /// Imutavel apos a criacao.
  code String @unique

  legalName String
  tradeName String?

  /// Somente digitos. Unicidade (quando informado) garantida por indice
  /// parcial na migration — Prisma nao modela unique index parcial.
  cnpj  String?
  email String?
  phone String?
  notes String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  receipts       Receipt[]
  lots           Lot[]

  @@index([active])
  @@map("suppliers")
}

/// Cliente. Cadastro base: sem CRM, tabela de preco ou pedido neste momento.
model Customer {
  id   String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, CLI-000001).
  /// Imutavel apos a criacao.
  code String @unique

  legalName String
  tradeName String?

  /// Somente digitos. Unicidade (quando informado) garantida por indice
  /// parcial na migration — Prisma nao modela unique index parcial.
  cnpj  String?
  email String?
  phone String?
  city  String?

  /// UF brasileira, sempre maiuscula.
  state String?
  notes String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@index([active])
  @@map("customers")
}

/// Definicao comercial/industrial do produto fabricado pela Veridi.
/// Distinto de Item: Item e a entidade fisica controlada em estoque
/// (inclusive o Item FINISHED_PRODUCT correspondente); Product e a
/// definicao comercial a que pertencerao formulacoes e OPs no futuro.
/// Cadastro base: sem formulacao, OP, preco ou multiplos SKUs neste momento.
model Product {
  id   String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, PROD-000001).
  /// Imutavel apos a criacao.
  code String @unique

  name String

  /// Cliente opcional. Associacao historica preservada mesmo se o
  /// Customer for inativado depois — regra de negocio validada no service,
  /// nao no schema.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// Item FINISHED_PRODUCT opcional, 1:1 (unique mesmo sendo nullable —
  /// Postgres permite multiplos NULL em indice unique, sem precisar de
  /// indice parcial). type/active validados no service na criacao do
  /// vinculo; associacao historica preservada se o Item for inativado depois.
  finishedProductItemId String? @unique
  finishedProductItem   Item?   @relation(fields: [finishedProductItemId], references: [id])

  externalCode String?
  notes        String?
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([customerId])
  @@map("products")
}

/// Ordem de Compra — primeira feature transacional. DRAFT e livremente
/// editavel; ao confirmar (ORDERED) o conteudo (fornecedor/itens/
/// quantidades/precos) fica congelado — so previsao de entrega e
/// observacoes continuam editaveis. Sem exclusao fisica; cancelar preserva
/// o documento no historico.
model PurchaseOrder {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, OC-000001).
  /// Imutavel apos a criacao.
  code String @unique

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  /// Snapshot do fornecedor no momento do pedido. Acompanha edicoes
  /// enquanto DRAFT (revalidado a cada save); congela ao confirmar.
  /// Fonte de verdade para exibir o documento, independente de mudancas
  /// futuras no cadastro de Supplier.
  supplierCode String
  supplierName String
  supplierCnpj String?

  orderDate            DateTime
  expectedDeliveryDate DateTime?

  status PurchaseOrderStatus @default(DRAFT)
  notes  String?

  orderedAt DateTime?
  orderedBy String?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  lines    PurchaseOrderLine[]
  receipts Receipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierId])
  @@map("purchase_orders")
}

/// Linha de Ordem de Compra. So existem/mudam enquanto a OC e DRAFT —
/// congeladas junto com o documento ao confirmar.
model PurchaseOrderLine {
  id String @id @default(uuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Snapshot do item no momento da linha — mesma logica do supplier acima.
  itemCode String
  itemName String
  unitCode String

  orderedQuantity Decimal  @db.Decimal(18, 6)
  unitPrice       Decimal? @db.Decimal(14, 4)

  receiptLines ReceiptLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mesmo Item nao pode aparecer duas vezes na mesma OC (MVP).
  @@unique([purchaseOrderId, itemId])
  @@map("purchase_order_lines")
}

/// Evento de recebimento CONFIRMADO de uma Ordem de Compra. Sem DRAFT
/// persistido — o frontend monta tudo e confirma de uma vez. Historico/
/// somente-leitura depois de criado; nunca excluido.
///
/// Nao duplica snapshot de fornecedor: reaproveita o snapshot ja congelado
/// em PurchaseOrder (supplierCode/supplierName/supplierCnpj), suficiente
/// e imutavel. supplierId fica aqui so para filtro direto.
model Receipt {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, REC-000001).
  code String @unique

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  receivedAt        DateTime
  invoiceNumber     String?
  documentReference String?
  notes             String?

  lines ReceiptLine[]

  createdAt DateTime @default(now())
  createdBy String?

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@map("receipts")
}

/// Linha de recebimento — quanto de uma PurchaseOrderLine chegou fisicamente
/// neste Receipt. Item code/nome ja estao congelados na PurchaseOrderLine
/// vinculada; nao duplica aqui.
model ReceiptLine {
  id String @id @default(uuid())

  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  purchaseOrderLineId String
  purchaseOrderLine    PurchaseOrderLine @relation(fields: [purchaseOrderLineId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  receivedQuantity Decimal @db.Decimal(18, 6)
  unitCode         String

  /// Identificacao do fornecedor para o lote — nunca substituida pelo
  /// nosso codigo interno. Obrigatoria quando Item.controlsLot=true.
  supplierLot String?

  /// Obrigatoria quando Item.controlsExpiry=true; nunca anterior a receivedAt.
  expiryDate DateTime?

  /// Local fisico simples (string livre) — sem Warehouse/Zone/Bin ainda.
  location String?

  /// Preenchido apos a criacao do Lot (mesma transacao) quando
  /// Item.controlsLot=true. Null quando o item nao controla lote.
  lotId String? @unique
  lot   Lot?    @relation(fields: [lotId], references: [id])

  createdAt DateTime @default(now())

  @@index([purchaseOrderLineId])
  @@index([itemId])
  @@map("receipt_lines")
}

/// Lote interno — criado automaticamente quando Item.controlsLot=true.
/// `initialReceivedQuantity` e so o quanto entrou neste recebimento: NAO e
/// saldo atual. Saldo fisico vira do ledger de Inventory Movements, ainda
/// nao implementado.
model Lot {
  id String @id @default(uuid())

  /// LT-YYYYMMDD-NNNNNN — data do recebimento + sequence global
  /// (nao reinicia por dia). Gerado pelo backend, imutavel, unico.
  code String @unique

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  receiptLine ReceiptLine?

  supplierLot String?
  expiryDate  DateTime?

  initialReceivedQuantity Decimal @db.Decimal(18, 6)

  status   LotStatus @default(AVAILABLE)
  location String?

  releasedAt DateTime?
  releasedBy String?

  blockedAt   DateTime?
  blockedBy   String?
  blockReason String?

  createdAt DateTime @default(now())
  createdBy String?

  @@index([itemId])
  @@index([supplierId])
  @@index([status])
  @@map("lots")
}
