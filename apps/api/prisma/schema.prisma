// Veridi Nutrition — schema Prisma

/// ATENCAO: as acoes de ON DELETE que valem sao as das migrations, nao a
/// opcionalidade dos campos deste arquivo. Relacao opcional (`Tipo?`) sem
/// `onDelete:` sugere SET NULL, mas boa parte delas virou ON DELETE RESTRICT
/// no banco. Antes de escrever script de manutencao ou raciocinar sobre
/// cascata, confira a acao real: `node scripts/maintenance/fk-order.mjs` le
/// `pg_constraint`, imprime a ordem de remocao e lista cada divergencia.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_PRODUCT
}

enum UomDimension {
  MASS
  COUNT
  VOLUME
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderOrigin {
  MANUAL
  CUSTOMER_ORDER
}

enum LotStatus {
  AWAITING_RELEASE
  AVAILABLE
  BLOCKED
  EXPIRED
}

/// Tipos do ledger de estoque. Preparado para expansao futura
/// (RETURN_TO_STOCK) — nao criado agora porque devolucao pos-producao
/// ainda nao existe.
enum InventoryMovementType {
  RECEIPT_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  LOSS
  PRODUCTION_CONSUMPTION
  /// Saldo fisico de abertura da migracao. Entrada auditavel, usada uma
  /// unica vez por lote: nao e recebimento de compra, nao e producao e nao
  /// e ajuste de inventario.
  OPENING_BALANCE
  /// Saida fisica de material usado em amostra/piloto. E consumo real de
  /// desenvolvimento — nunca disfarcado de ajuste.
  SAMPLE_CONSUMPTION
  FINISHED_GOOD_PRODUCTION
  SHIPMENT_OUT
}

enum InventoryMovementSourceType {
  /// Linha do template de abertura da migracao; `sourceId` guarda a chave
  /// estavel daquela linha (idempotencia).
  OPENING_BALANCE
  PROJECT_SAMPLE
  RECEIPT
  MANUAL_ADJUSTMENT
  STOCK_COUNT
  MANUAL_LOSS
  PRODUCTION_CONSUMPTION
  FINISHED_GOOD_PRODUCTION
  SHIPMENT
}

/// Lote recebido (RECEIPT, Supplier/Receipt/OC) ou lote produzido
/// (PRODUCTION, ProductionOutput/ProductionOrder/Product) — mesma
/// infraestrutura de Lot para as duas origens, nunca uma segunda tabela
/// paralela so para produto acabado.
enum LotOrigin {
  RECEIPT
  PRODUCTION
  /// Lote informado na migracao (saldo fisico de abertura). Nao e compra
  /// nem producao: nasce sem fornecedor e sem OP, e existe para que o
  /// estoque inicial tenha rastreabilidade real em vez de lote inventado.
  OPENING_BALANCE
}

/// Perfil do usuario. RBAC simples: ADMIN administra usuarios e documentos
/// controlados; os demais usam a operacao normal. Nao existe matriz de
/// permissao por botao nesta fase.
enum UserRole {
  ADMIN
  PRODUCTION
  QUALITY
  PURCHASING
  COMMERCIAL
  VIEWER
}

/// Tipos de documento controlado suportados. Codigos reais: R.PRO.002
/// (Ordem de Producao) e R.COQ.003 (Folha de Receita).
enum ControlledDocumentType {
  PRODUCTION_ORDER
  RECIPE_SHEET
}

/// Estagio da amostra/teste. Aprovar a amostra NUNCA aprova o projeto —
/// sao decisoes diferentes (tecnica x comercial).
enum ProjectSampleStatus {
  DRAFT
  IN_PROGRESS
  PRODUCED
  APPROVED
  REJECTED
  CANCELLED
}

enum ProjectSampleSource {
  MANUAL
  LEGACY_IMPORT
}

/// Pipeline comercial do projeto — vocabulario observado na operacao real
/// da Veridi, nao um workflow configuravel.
enum ProjectStatus {
  WAITING
  SAMPLE
  APPROVED
  CANCELLED
  STAND_BY
}

/// Motivo do cancelamento. OTHER exige texto livre complementar.
enum ProjectCancelReason {
  PRICE
  COMPETITOR
  PROJECT_CHANGED
  NOT_MET
  OTHER
}

/// Origem do registro. LEGACY_IMPORT existe para explicar estados
/// historicos incompletos sem afrouxar as regras do fluxo novo.
enum ProjectSource {
  MANUAL
  LEGACY_IMPORT
}

/// Ciclo do orcamento. So DRAFT e editavel; SUPERSEDED marca a versao
/// substituida por uma nova negociacao; ARCHIVED cobre historico legado
/// incompleto (sem preco, sem evidencia de envio).
enum QuotePaymentMethod {
  CASH
  INSTALLMENTS
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
  ARCHIVED
}

/// Estado DOCUMENTAL do laudo/CoA do lote — independente do status
/// operacional (LotStatus). Aprovar o CoA nunca libera o lote sozinho: a
/// liberacao da Qualidade continua sendo acao explicita.
enum CoaStatus {
  NOT_REQUIRED
  PENDING
  RECEIVED
  APPROVED
  REJECTED
}

/// Tipo do documento anexado. Cada contexto aceita um subconjunto:
/// Lot -> COA/OTHER, Receipt -> INVOICE/OTHER, Product -> LABEL_ART/
/// TECHNICAL_SHEET/OTHER.
enum AttachmentType {
  COA
  INVOICE
  LABEL_ART
  TECHNICAL_SHEET
  BRIEFING
  SAMPLE_RESULT
  OTHER
}

/// Estado de uma parte/fracao da producao. Simples de proposito.
enum ProductionPartStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// Quem DEVE fornecer o componente conforme a formulacao — intencao/regra,
/// nunca realidade fisica. A realidade fisica e o dono do Lot
/// (InventoryOwnerType).
enum SupplyResponsibility {
  VERIDI
  CUSTOMER
}

/// Dono do estoque fisico. Material do cliente fica dentro da Veridi mas
/// continua sendo do cliente — nunca some com o estoque proprio.
enum InventoryOwnerType {
  VERIDI
  CUSTOMER
}

/// Origem do Recebimento. CUSTOMER_SUPPLIED existe para NAO precisar de
/// Ordem de Compra falsa nem Fornecedor fake quando o material vem do
/// proprio cliente.
enum ReceiptSourceType {
  PURCHASE_ORDER
  CUSTOMER_SUPPLIED
}

/// Como a versao calcula a necessidade de material.
/// FIXED_BASIS: "estas quantidades produzem `basisQuantity`" (modelo
/// original, preservado). PER_DOSE: a formula e declarada por DOSE do
/// produto acabado, do jeito que a industria realmente trabalha.
enum FormulationCalculationMode {
  FIXED_BASIS
  PER_DOSE
}

/// Base de calculo do COMPONENTE. Uma mesma versao PER_DOSE tem
/// ingredientes por dose e embalagem por unidade acabada — cada linha
/// declara a propria base, sem engine de expressao.
enum FormulationComponentBasis {
  FIXED_BASIS
  PER_DOSE
  PER_FINISHED_UNIT
}

/// Ciclo de vida de uma versao de TEMPLATE.
///
/// ARCHIVED em vez de INACTIVE: a Formulacao de um Produto e desativada
/// quando outra assume; um template e ARQUIVADO quando sai da biblioteca.
/// Sao coisas diferentes e o vocabulario acompanha.
/// Ciclo de vida das matrizes de biblioteca (estrutura de custos e politica
/// de precificacao). Mesmo vocabulario do template de formulacao: ARQUIVADA
/// porque sai da biblioteca, nao porque outra assumiu o lugar dela.
enum TemplateVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FormulationTemplateVersionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum FormulationVersionStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// Lifecycle completo do roadmap — esta entrega so implementa
/// DRAFT->PLANNED e DRAFT/PLANNED->CANCELLED. RELEASED em diante chega
/// junto de Material Reservation.
enum ProductionOrderStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PRODUCTION
  COMPLETED
  BLOCKED
  CANCELLED
}

/// CUSTOMER_ORDER fica para o Bloco D (Pedidos & Atendimento) — nao criar
/// referencia fake agora.
enum ProductionOrderOrigin {
  MANUAL
  STOCK_PRODUCTION
  CUSTOMER_ORDER
}

/// DRAFT editavel; CONFIRMED congela cliente/produtos/quantidades (snapshot)
/// e habilita o Plano de Atendimento; IN_FULFILLMENT ocorre quando o Plano e
/// aplicado (reserva de PA + OPs DRAFT geradas). READY/PARTIALLY_SHIPPED/
/// SHIPPED ficam para expedicao futura, nao alcancaveis ainda.
enum CustomerOrderStatus {
  DRAFT
  CONFIRMED
  IN_FULFILLMENT
  PARTIALLY_SHIPPED
  SHIPPED
  CANCELLED
}

enum CustomerOrderReservationStatus {
  ACTIVE
  RELEASED
}

/// DRAFT e so separacao (nunca altera estoque); CONFIRMED e a saida fisica
/// real (gera SHIPMENT_OUT) e e historico imutavel — reversao exigiria
/// devolucao/reentrada explicita, nao implementada nesta fase.
enum ShipmentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Faturamento COMERCIAL/OPERACIONAL — nunca documento fiscal (NF-e/SEFAZ/
/// impostos estao fora do MVP). DRAFT permite so preco/observacoes/
/// referencia externa; ISSUED e historico imutavel (correcao pos-emissao
/// fica futura). Billing nunca movimenta estoque.
enum BillingStatus {
  DRAFT
  ISSUED
  CANCELLED
}

/// ACTIVE conta em Reserved; RELEASED (a reserva foi liberada — ex.:
/// cancelamento de OP RELEASED) nao conta mais. Nunca deletado — historico.
enum MaterialReservationStatus {
  ACTIVE
  RELEASED
}

/// Usuario do sistema. Existe para autenticacao e, principalmente, para
/// responder QUEM executou uma acao GMP — nunca um modulo de RH.
model User {
  id String @id @default(uuid())

  /// USR-000001 — sequence dedicada, mesmo padrao dos demais codigos.
  code String @unique

  name String

  /// Sempre normalizado em minusculas antes de gravar.
  email String @unique

  /// Hash da senha (scrypt com salt por usuario). Senha em texto nunca e
  /// gravada nem logada.
  passwordHash String

  role   UserRole @default(VIEWER)
  active Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions UserSession[]

  preparedDocumentRevisions  ControlledDocumentRevision[]       @relation("DocumentPreparedBy")
  approvedDocumentRevisions  ControlledDocumentRevision[]       @relation("DocumentApprovedBy")
  startedParts               ProductionOrderPart[]              @relation("PartStartedBy")
  completedParts             ProductionOrderPart[]              @relation("PartCompletedBy")
  recipeWeighings            RecipeWeighing[]
  uploadedAttachments        Attachment[]                       @relation("AttachmentUploadedBy")
  archivedAttachments        Attachment[]                       @relation("AttachmentArchivedBy")
  reviewedCoaLots            Lot[]                              @relation("CoaReviewedBy")
  responsibleProjects        Project[]                          @relation("ProjectResponsible")
  createdProjects            Project[]                          @relation("ProjectCreatedBy")
  projectStatusChanges       ProjectStatusHistory[]             @relation("ProjectStatusChangedBy")
  createdProjectProducts     ProjectProduct[]                   @relation("ProjectProductCreatedBy")
  createdQuotes              QuoteVersion[]                     @relation("QuoteCreatedBy")
  sentQuotes                 QuoteVersion[]                     @relation("QuoteSentBy")
  acceptedQuotes             QuoteVersion[]                     @relation("QuoteAcceptedBy")
  rejectedQuotes             QuoteVersion[]                     @relation("QuoteRejectedBy")
  createdSamples             ProjectSample[]                    @relation("SampleCreatedBy")
  startedSamples             ProjectSample[]                    @relation("SampleStartedBy")
  producedSamples            ProjectSample[]                    @relation("SampleProducedBy")
  approvedSamples            ProjectSample[]                    @relation("SampleApprovedBy")
  rejectedSamples            ProjectSample[]                    @relation("SampleRejectedBy")
  cancelledSamples           ProjectSample[]                    @relation("SampleCancelledBy")
  sampleConsumptions         SampleConsumption[]                @relation("SampleConsumptionBy")
  createdSupplierItems       SupplierItem[]                     @relation("SupplierItemCreatedBy")
  updatedSupplierItems       SupplierItem[]                     @relation("SupplierItemUpdatedBy")
  supplierItemQualifications SupplierItemQualificationHistory[] @relation("SupplierItemQualificationBy")
  createdSupplierItemOffers  SupplierItemOffer[]                @relation("SupplierItemOfferCreatedBy")
  createdIndustrialCosts     IndustrialCostVersion[]            @relation("IndustrialCostCreatedBy")
  activatedIndustrialCosts   IndustrialCostVersion[]            @relation("IndustrialCostActivatedBy")
  industrialCostCalculations IndustrialCostCalculation[]        @relation("IndustrialCostCalculationBy")
  createdPricingVersions     PricingVersion[]                   @relation("PricingVersionCreatedBy")
  activatedPricingVersions   PricingVersion[]                   @relation("PricingVersionActivatedBy")
  createdIndustrialResources IndustrialResource[]               @relation("IndustrialResourceCreatedBy")
  updatedIndustrialResources IndustrialResource[]               @relation("IndustrialResourceUpdatedBy")
  createdCustomers           Customer[]                         @relation("CustomerCreatedBy")
  updatedCustomers           Customer[]                         @relation("CustomerUpdatedBy")
  createdIndustrialRates     IndustrialResourceRate[]           @relation("IndustrialResourceRateCreatedBy")

  @@index([active])
  @@map("users")
}

/// Sessao opaca: o token bruto so existe no cookie HttpOnly; o banco guarda
/// apenas o hash. Logout revoga; usuario inativo deixa de ser aceito.
model UserSession {
  id String @id @default(uuid())

  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("user_sessions")
}

/// Revisao de documento controlado (R.PRO.002, R.COQ.003). Nao e GED nem
/// workflow documental: e o cabecalho que a impressao precisa e o historico
/// de revisoes. Revisao ja usada por documento operacional nunca e editada.
model ControlledDocumentRevision {
  id String @id @default(uuid())

  type         ControlledDocumentType
  documentCode String
  title        String
  revision     String
  revisionDate DateTime?

  /// Snapshot do nome junto do id: inativar/renomear o usuario depois nao
  /// pode reescrever o documento historico.
  preparedByUserId       String?
  preparedByUser         User?   @relation("DocumentPreparedBy", fields: [preparedByUserId], references: [id])
  preparedByNameSnapshot String?

  approvedByUserId       String?
  approvedByUser         User?   @relation("DocumentApprovedBy", fields: [approvedByUserId], references: [id])
  approvedByNameSnapshot String?

  /// Uma unica revisao ACTIVE por tipo (garantido no service, sob lock).
  active Boolean @default(false)

  createdAt DateTime @default(now())

  productionOrdersAsProductionOrderDoc ProductionOrder[] @relation("ProductionOrderDocumentRevision")
  productionOrdersAsRecipeDoc          ProductionOrder[] @relation("RecipeSheetDocumentRevision")

  @@unique([type, revision])
  @@index([type, active])
  @@map("controlled_document_revisions")
}

/// Contador da numeracao oficial anual da OP (001/26). Linha por ano,
/// atualizada sob `FOR UPDATE` — nunca MAX(numero)+1.
model ProductionOrderNumberCounter {
  year       Int @id
  lastNumber Int @default(0)

  @@map("production_order_number_counters")
}

/// Parte/fracao da producao (o misturador nao comporta o lote inteiro).
/// Gerada no RELEASE, a partir de `ProductionOrder.numberOfParts`.
model ProductionOrderPart {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  partNumber Int
  status     ProductionPartStatus @default(PENDING)

  startedAt             DateTime?
  startedByUserId       String?
  startedByUser         User?     @relation("PartStartedBy", fields: [startedByUserId], references: [id])
  startedByNameSnapshot String?

  completedAt             DateTime?
  completedByUserId       String?
  completedByUser         User?     @relation("PartCompletedBy", fields: [completedByUserId], references: [id])
  completedByNameSnapshot String?

  createdAt DateTime @default(now())

  weighings RecipeWeighing[]

  @@unique([productionOrderId, partNumber])
  @@map("production_order_parts")
}

/// Pesagem real registrada na Folha de Receita (R.COQ.003). E a ORIGEM/
/// auditoria da execucao — nunca baixa estoque por conta propria: a baixa
/// continua sendo ProductionConsumption -> InventoryMovement.
model RecipeWeighing {
  id String @id @default(uuid())

  productionOrderPartId String
  productionOrderPart   ProductionOrderPart @relation(fields: [productionOrderPartId], references: [id], onDelete: Cascade)

  productionOrderRequirementId String
  productionOrderRequirement   ProductionOrderRequirement @relation(fields: [productionOrderRequirementId], references: [id])

  materialReservationLineId String?
  materialReservationLine   MaterialReservationLine? @relation(fields: [materialReservationLineId], references: [id])

  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  /// Quanto a parte deveria pesar quando a pesagem foi registrada.
  plannedQuantitySnapshot Decimal @db.Decimal(18, 6)
  /// Quanto realmente foi pesado. Diferenca e registrada, nunca escondida.
  actualQuantity          Decimal @db.Decimal(18, 6)
  uomCode                 String

  executedByUserId       String
  executedByUser         User     @relation(fields: [executedByUserId], references: [id])
  /// Nome no momento do registro — impressao historica nunca depende do
  /// cadastro atual.
  executedByNameSnapshot String
  executedAt             DateTime @default(now())

  /// 1:1 com o consumo real gerado por esta pesagem. Unico e imutavel:
  /// confirmar de novo nunca gera segunda baixa.
  productionConsumptionId String?                @unique
  productionConsumption   ProductionConsumption? @relation(fields: [productionConsumptionId], references: [id])

  notes String?

  createdAt DateTime @default(now())

  @@index([productionOrderRequirementId])
  @@map("recipe_weighings")
}

/// Documento anexado (laudo/CoA, NF, arte de rotulo, ficha tecnica).
///
/// O arquivo NAO fica no banco nem em diretorio publico: o conteudo vai
/// para o storage local via adapter (`lib/file-storage.ts`) sob uma
/// `storageKey` aleatoria; o nome original so serve para exibicao/download.
/// Anexo nunca e excluido fisicamente pela operacao — arquiva-se, para nao
/// destruir evidencia historica.
model Attachment {
  id String @id @default(uuid())

  documentType AttachmentType

  /// Exatamente UM contexto (CHECK no banco): lote, recebimento ou
  /// produto. `projectId` entra na capacidade 38 como migration simples.
  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  receiptId String?
  receipt   Receipt? @relation(fields: [receiptId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  projectSampleId String?
  projectSample   ProjectSample? @relation(fields: [projectSampleId], references: [id])

  originalFileName String
  mimeType         String
  sizeBytes        Int
  /// SHA-256 do conteudo — integridade/auditoria, nunca deduplicacao automatica.
  sha256           String
  /// Identificador interno no storage. Aleatorio: nome enviado pelo usuario
  /// jamais vira caminho de arquivo.
  storageKey       String @unique

  uploadedAt             DateTime @default(now())
  uploadedByUserId       String
  uploadedByUser         User     @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id])
  uploadedByNameSnapshot String

  archivedAt             DateTime?
  archivedByUserId       String?
  archivedByUser         User?     @relation("AttachmentArchivedBy", fields: [archivedByUserId], references: [id])
  archivedByNameSnapshot String?

  @@index([lotId])
  @@index([receiptId])
  @@index([productId])
  @@index([projectId])
  @@index([projectSampleId])
  @@index([documentType])
  @@map("attachments")
}

/// Projeto private label — o funil comercial ANTES do produto existir.
///
/// Project e Product sao coisas diferentes: Project e o desenvolvimento/
/// negociacao; Product e o produto aprovado e operacional. A aprovacao do
/// projeto e o momento em que um vira o outro.
model Project {
  id String @id @default(uuid())

  /// PROJ-000001 — sequence dedicada, mesmo padrao dos demais codigos.
  code String @unique

  /// Codigo da planilha historica (ex.: `0001PL`). Convive com `code`;
  /// pode coincidir com `Product.externalCode` — isso e esperado.
  externalCode String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  name String

  /// Vocabulario ABERTO (Detox, Sono, Massa Muscular...) — texto livre com
  /// sugestao pelos valores ja existentes, nunca enum rigido.
  concept String?
  /// Canal do cliente (Academia, Distribuidora, Farm. Manip....). Idem.
  channel String?

  status ProjectStatus @default(WAITING)
  source ProjectSource @default(MANUAL)

  responsibleUserId String?
  responsibleUser   User?   @relation("ProjectResponsible", fields: [responsibleUserId], references: [id])

  entryDate DateTime
  notes     String?

  cancelReason        ProjectCancelReason?
  cancelReasonDetails String?
  cancelledAt         DateTime?
  approvedAt          DateTime?

  /// Perfil tecnico pretendido — BRIEF, nao Product. Copiado para o Product
  /// na aprovacao; a partir dai as duas entidades seguem separadas.
  dosageForm           DosageForm?
  presentationType     PresentationType?
  doseAmount           Decimal?          @db.Decimal(18, 6)
  doseUomCode          String?
  doseUom              UnitOfMeasure?    @relation("ProjectDoseUom", fields: [doseUomCode], references: [code])
  dosesPerPackage      Int?
  targetAgeGroup       TargetAgeGroup?
  minimumBatchQuantity Decimal?          @db.Decimal(18, 6)
  shelfLifeMonths      Int?

  /// Produto resultante. Null enquanto o projeto nao foi aprovado — e
  /// tambem em projeto legado aprovado sem produto correspondente.
  productId String?  @unique
  product   Product? @relation(fields: [productId], references: [id])

  /// Produtos tecnicos criados por este projeto. Diferente de `product`,
  /// que e o principal/legado.
  originatedProducts Product[] @relation("ProductOriginProject")

  createdAt             DateTime @default(now())
  createdByUserId       String?
  createdByUser         User?    @relation("ProjectCreatedBy", fields: [createdByUserId], references: [id])
  createdByNameSnapshot String?
  updatedAt             DateTime @updatedAt

  quoteVersions QuoteVersion[]
  statusHistory ProjectStatusHistory[]
  attachments   Attachment[]
  samples       ProjectSample[]
  /// Produtos do projeto. `productId` acima continua existindo como o
  /// produto principal/legado; a associacao real vive aqui.
  products      ProjectProduct[]

  /// Pedidos originados de propostas aceitas deste projeto.
  sourcedCustomerOrders CustomerOrder[] @relation("CustomerOrderSourceProject")

  @@index([customerId])
  @@index([status])
  @@index([externalCode])
  @@map("projects")
}

/// Situacao COMERCIAL do produto dentro do projeto.
///
/// Nao se confunde com `Product.lifecycle` (DEVELOPMENT/APPROVED), que e a
/// situacao TECNICA do produto e vale fora deste projeto. Um produto pode
/// estar aprovado tecnicamente e fora do escopo comercial desta negociacao.
enum ProjectProductStatus {
  /// Em desenvolvimento dentro do projeto.
  ACTIVE
  /// Presente no orcamento aceito que aprovou o projeto.
  APPROVED
  /// Desenvolvido, mas fora do orcamento aceito. Historia tecnica fica.
  OUT_OF_SCOPE
}

/// Produto de um projeto.
///
/// Um projeto e uma negociacao, e negociacao real costuma cobrir varios
/// produtos: a mesma linha em tres sabores nasce de um briefing so e vira
/// uma proposta so. `Project.productId` (1:1) continua existindo para nao
/// quebrar o legado; a associacao verdadeira passa a ser esta.
model ProjectProduct {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Ordem de exibicao — a ordem em que o comercial pensa a linha.
  sequence Int

  status ProjectProductStatus @default(ACTIVE)

  createdAt             DateTime @default(now())
  createdByUserId       String?
  createdByUser         User?    @relation("ProjectProductCreatedBy", fields: [createdByUserId], references: [id])
  createdByNameSnapshot String?
  updatedAt             DateTime @updatedAt

  quoteLines QuoteLine[]
  samples    ProjectSample[]

  /// O mesmo produto nao entra duas vezes no mesmo projeto.
  @@unique([projectId, productId])
  @@index([projectId])
  @@index([productId])
  @@map("project_products")
}

/// Historico imutavel do pipeline. `updatedAt` nao conta historia.
model ProjectStatusHistory {
  id String @id @default(uuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  fromStatus ProjectStatus?
  toStatus   ProjectStatus
  reason     String?

  changedAt             DateTime @default(now())
  changedByUserId       String?
  changedByUser         User?    @relation("ProjectStatusChangedBy", fields: [changedByUserId], references: [id])
  changedByNameSnapshot String?

  @@index([projectId])
  @@map("project_status_history")
}

/// Versao de orcamento. A negociacao acontece por VERSAO: enviado congela
/// snapshot e vira imutavel; nova proposta e sempre uma versao nova.
model QuoteVersion {
  id String @id @default(uuid())

  /// ORC-000001 — identidade global; `versionNumber` sozinho nao identifica.
  code String @unique

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  versionNumber Int
  externalCode  String?

  status QuoteStatus   @default(DRAFT)
  source ProjectSource @default(MANUAL)

  quoteDate  DateTime
  validUntil DateTime?

  currencyCode String @default("BRL")

  commercialNotes String?
  paymentTerms    String?
  leadTimeDays    Int?

  /// Desconto comercial sobre o subtotal das linhas (10 = 10%).
  discountPercent Decimal? @db.Decimal(7, 4)

  /// A vista ou parcelado. O plano de pagamento e DERIVADO destes campos —
  /// valor de parcela nao se digita, senao a proposta impressa e a conta do
  /// sistema divergem sem ninguem perceber.
  paymentMethod QuotePaymentMethod @default(CASH)

  /// Entrada em % do total (so parcelado). Null = sem entrada.
  downPaymentPercent      Decimal? @db.Decimal(7, 4)
  /// Numero de parcelas DEPOIS da entrada.
  installmentCount        Int?
  /// Dias entre parcelas. 30 = mensal.
  installmentIntervalDays Int?
  /// Juros ao mes sobre o saldo parcelado (2 = 2% a.m.). Null ou zero = sem juros.
  monthlyInterestPercent  Decimal? @db.Decimal(7, 4)

  sentAt             DateTime?
  sentByUserId       String?
  sentByUser         User?     @relation("QuoteSentBy", fields: [sentByUserId], references: [id])
  sentByNameSnapshot String?

  acceptedAt             DateTime?
  acceptedByUserId       String?
  acceptedByUser         User?     @relation("QuoteAcceptedBy", fields: [acceptedByUserId], references: [id])
  acceptedByNameSnapshot String?

  rejectedAt             DateTime?
  rejectedByUserId       String?
  rejectedByUser         User?     @relation("QuoteRejectedBy", fields: [rejectedByUserId], references: [id])
  rejectedByNameSnapshot String?
  rejectionReason        String?

  /// Snapshot congelado no envio — imprimir amanha nao depende do cadastro
  /// atual do cliente nem do projeto.
  customerCode       String?
  customerName       String?
  customerTradeName  String?
  customerCnpj       String?
  customerZipCode    String?
  customerStreet     String?
  customerNumber     String?
  customerComplement String?
  customerDistrict   String?
  customerCity       String?
  customerState      String?
  projectCode        String?
  projectName        String?
  projectConcept     String?
  projectChannel     String?

  createdAt             DateTime @default(now())
  createdByUserId       String?
  createdByUser         User?    @relation("QuoteCreatedBy", fields: [createdByUserId], references: [id])
  createdByNameSnapshot String?
  updatedAt             DateTime @updatedAt

  /// Uma linha por produto. O total da proposta e a soma das linhas — o
  /// cabecalho nao guarda quantidade nem preco, para nao existirem duas
  /// fontes de verdade.
  lines QuoteLine[]

  /// O Pedido gerado a partir desta proposta aceita (no maximo um).
  sourcedCustomerOrder CustomerOrder? @relation("CustomerOrderSourceQuote")

  @@unique([projectId, versionNumber])
  @@index([projectId])
  @@index([status])
  @@map("quote_versions")
}

/// Linha de orcamento: um produto, sua quantidade e seu preco.
///
/// A negociacao real cobre varios produtos numa proposta so — tres sabores
/// da mesma linha, por exemplo. Cada linha carrega a PROPRIA proveniencia de
/// preco: uma pode vir de faixa de precificacao e outra ser excecao
/// comercial manual, e as duas coisas sao legitimas na mesma proposta.
model QuoteLine {
  id String @id @default(uuid())

  quoteVersionId String
  quoteVersion   QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  /// Vinculo com o produto DENTRO do projeto. Null em linha de projeto
  /// legado que nunca teve associacao explicita.
  projectProductId String?
  projectProduct   ProjectProduct? @relation(fields: [projectProductId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Ordem de exibicao e de impressao.
  sortOrder Int @default(0)

  quotedQuantity Decimal?       @db.Decimal(18, 6)
  uomCode        String?
  uom            UnitOfMeasure? @relation("QuoteLineUom", fields: [uomCode], references: [code])

  /// `null` = ainda nao precificado. `0` e preco zero explicito — os dois
  /// nunca se confundem.
  unitPrice Decimal? @db.Decimal(14, 4)

  /// Preco digitado ou vindo de uma faixa de precificacao ativa. Orcamento
  /// manual continua legitimo: o sistema aceita excecao comercial.
  priceSource QuotePriceSource @default(MANUAL)

  pricingVersionId String?
  pricingVersion   PricingVersion? @relation(fields: [pricingVersionId], references: [id])
  pricingTierId    String?
  pricingTier      PricingTier?    @relation(fields: [pricingTierId], references: [id])

  /// Congelado no ENVIO: a linha enviada guarda a cadeia economica que a
  /// gerou. PREC nova, CALC novo ou compra nova nunca reescrevem isto.
  productCodeSnapshot              String?
  productNameSnapshot              String?
  pricingCodeSnapshot              String?
  pricingVersionNumberSnapshot     Int?
  pricingTierQuantitySnapshot      Decimal?               @db.Decimal(18, 6)
  pricingTierUomSnapshot           String?
  pricingSelectedUnitPriceSnapshot Decimal?               @db.Decimal(14, 6)
  costCalculationCodeSnapshot      String?
  costReferenceDateSnapshot        DateTime?
  costStructureLabelSnapshot       String?
  formulationVersionNumberSnapshot Int?
  industrialCostPerUnitSnapshot    Decimal?               @db.Decimal(18, 6)
  costQualitySnapshot              IndustrialCostQuality?
  commissionPercentSnapshot        Decimal?               @db.Decimal(7, 4)
  contributionPerUnitSnapshot      Decimal?               @db.Decimal(14, 6)
  contributionMarginSnapshot       Decimal?               @db.Decimal(7, 4)
  markupSnapshot                   Decimal?               @db.Decimal(12, 4)
  /// Avisos economicos congelados (custo incompleto, contribuicao negativa).
  pricingWarningsSnapshot          Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourcedCustomerOrderLine CustomerOrderLine? @relation("CustomerOrderLineSourceQuoteLine")

  /// O mesmo produto nao entra duas vezes na mesma versao.
  @@unique([quoteVersionId, productId])
  @@index([quoteVersionId])
  @@index([productId])
  @@map("quote_lines")
}

/// Estrutura de custo industrial de um Product, versionada.
///
/// ESTRUTURA nao e CALCULO: aqui ficam as premissas (qual receita, qual
/// base de producao, quais custos adicionais existem). O custo industrial
/// consolidado sera calculado na capacidade 45 — esta versao nao guarda
/// total nem CMV.
///
/// A versao aponta para uma FormulationVersion ESPECIFICA, nunca para "a
/// formulacao ativa atual": custo precisa saber exatamente qual receita foi
/// usada, e trocar a formulacao ativa nao pode reescrever estrutura
/// historica.
model IndustrialCostVersion {
  id String @id @default(uuid())

  /// EC-000001 — identidade do documento.
  code String @unique

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Sequencial POR PRODUTO (V1, V2...), gerado sob lock.
  versionNumber Int

  status IndustrialCostVersionStatus @default(DRAFT)

  /// Receita exata desta estrutura. DRAFT pode apontar para formulacao
  /// DRAFT (trabalho de engenharia), mas ativar exige formulacao estavel.
  formulationVersionId String

  /// Rascunho SEGUE a formulacao ativa do produto por padrao: enquanto o
  /// produto esta sendo definido nao ha compromisso a proteger, e a lista de
  /// materiais e reflexo puro da formulacao (nao existe override por material,
  /// entao nada digitado se perde ao reapontar).
  ///
  /// `true` so quando o usuario escolheu EXPLICITAMENTE outra versao — ai
  /// seguir sozinho sobrescreveria uma decisao dele. Versao ATIVA nunca e
  /// tocada, fixada ou nao.
  formulationPinned  Boolean            @default(false)
  formulationVersion FormulationVersion @relation(fields: [formulationVersionId], references: [id])

  /// Base de producao usada para estruturar o custo (ex.: 1000 un). Nunca
  /// assumida: o usuario informa ou confirma a sugestao do lote minimo.
  referenceOutputQuantity Decimal       @db.Decimal(18, 6)
  referenceOutputUomCode  String
  referenceOutputUom      UnitOfMeasure @relation("IndustrialCostOutputUom", fields: [referenceOutputUomCode], references: [code])

  /// `NONE` significa energia ainda NAO estruturada — nunca energia zero.
  energyCalculationMode EnergyCalculationMode @default(NONE)

  /// Recurso de energia cuja tarifa valoriza o consumo DERIVADO dos
  /// equipamentos. Sem ele o kWh derivado nao vira dinheiro: escolher
  /// sozinho entre varios cadastros seria inventar premissa economica.
  energyResourceId String?
  energyResource   IndustrialResource? @relation("IndustrialCostEnergyResource", fields: [energyResourceId], references: [id])

  notes String?

  /// Snapshots congelados na ativacao — impressao e historico nao mudam
  /// porque alguem renomeou o produto depois.
  productCodeSnapshot              String?
  productNameSnapshot              String?
  customerCodeSnapshot             String?
  customerNameSnapshot             String?
  formulationVersionNumberSnapshot Int?
  unitsPerShippingBoxSnapshot      Int?

  createdAt             DateTime @default(now())
  createdByUserId       String?
  createdByUser         User?    @relation("IndustrialCostCreatedBy", fields: [createdByUserId], references: [id])
  createdByNameSnapshot String?

  activatedAt             DateTime?
  activatedByUserId       String?
  activatedByUser         User?     @relation("IndustrialCostActivatedBy", fields: [activatedByUserId], references: [id])
  activatedByNameSnapshot String?

  updatedAt DateTime @updatedAt

  /// TEMPLATE DE ESTRUTURA QUE SERVIU DE MOLDE — proveniencia, nunca vinculo.
  ///
  /// Aplicar um template COPIA a configuracao. Depois disso a estrutura do
  /// produto e o template seguem separados: o template pode ganhar V2 e esta
  /// estrutura continua sendo o que era. Nada se sincroniza, por decisao — um
  /// cliente nao pode ter o custo mudado porque outro pediu ajuste na matriz.
  originCostTemplateVersionId     String?
  originCostTemplateVersion       IndustrialCostTemplateVersion? @relation(fields: [originCostTemplateVersionId], references: [id], onDelete: SetNull)
  originCostTemplateCode          String?
  originCostTemplateVersionNumber Int?

  lines                   IndustrialCostLine[]
  resourceUsages          IndustrialCostResourceUsage[]
  calculations            IndustrialCostCalculation[]
  productionOrders        ProductionOrder[]             @relation("ProductionOrderCostVersion")
  productionCostSnapshots ProductionOrderCostSnapshot[]

  @@unique([productId, versionNumber])
  @@index([productId])
  @@index([status])
  @@index([originCostTemplateVersionId])
  @@map("industrial_cost_versions")
}

/// Premissa de custo informada manualmente (o que NAO vem da Formulacao).
///
/// `rateValue` nulo significa VALOR NAO INFORMADO — nunca zero. Zero e um
/// zero explicito. E por isso que a estrutura pode existir completa em
/// escopo e ainda incompleta em premissas economicas.
model IndustrialCostLine {
  id String @id @default(uuid())

  industrialCostVersionId String
  industrialCostVersion   IndustrialCostVersion @relation(fields: [industrialCostVersionId], references: [id], onDelete: Cascade)

  category    IndustrialCostCategory
  description String

  calculationBasis IndustrialCostBasis

  /// Valor em BRL, ou percentual quando a base e percentual (10 = 10%).
  /// Sem multi-moeda nesta fase.
  rateValue Decimal? @db.Decimal(14, 4)

  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industrialCostVersionId])
  @@map("industrial_cost_lines")
}

/// Recurso industrial (mao de obra, equipamento, energia).
///
/// LABOR e CATEGORIA economica, nao pessoa: `User` (capacidade 36) diz quem
/// executou um ato; o recurso diz quanto custa uma hora daquela funcao. Os
/// dois nunca se relacionam automaticamente.
model IndustrialResource {
  id String @id @default(uuid())

  /// REC-000001 — codigo de negocio visivel.
  code String @unique

  name        String
  type        IndustrialResourceType
  description String?

  /// Unidade em que o recurso e consumido (hora, kWh) — derivada do tipo.
  defaultUsageUom IndustrialRateUom

  /// Potencia nominal, so para equipamento. `null` = DESCONHECIDA: nunca
  /// se assume potencia padrao, e o cadastro do equipamento nao trava por
  /// causa disso.
  powerKw Decimal? @db.Decimal(12, 4)

  notes  String?
  active Boolean @default(true)

  createdAt             DateTime @default(now())
  createdByUserId       String?
  createdByUser         User?    @relation("IndustrialResourceCreatedBy", fields: [createdByUserId], references: [id])
  createdByNameSnapshot String?

  updatedAt             DateTime @updatedAt
  updatedByUserId       String?
  updatedByUser         User?    @relation("IndustrialResourceUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedByNameSnapshot String?

  rates                  IndustrialResourceRate[]
  usages                 IndustrialCostResourceUsage[]
  energyForVersions      IndustrialCostVersion[]               @relation("IndustrialCostEnergyResource")
  templateUsages         IndustrialCostTemplateResourceUsage[] @relation("CostTemplateResourceUsage")
  energyForCostTemplates IndustrialCostTemplateVersion[]       @relation("CostTemplateEnergyResource")

  @@index([type])
  @@index([active])
  @@map("industrial_resources")
}

/// Tarifa historica do recurso. IMUTAVEL: tarifa mudou, registra-se outra.
///
/// Por isso nao existe `currentRate` no recurso — a vigente e derivada da
/// data de referencia, e o historico continua inteiro para que uma
/// estrutura antiga nunca mude de valor sozinha.
model IndustrialResourceRate {
  id String @id @default(uuid())

  industrialResourceId String
  industrialResource   IndustrialResource @relation(fields: [industrialResourceId], references: [id], onDelete: Cascade)

  rateValue    Decimal           @db.Decimal(14, 4)
  currencyCode String            @db.VarChar(3)
  rateUom      IndustrialRateUom

  /// Sem vigencia confiavel a tarifa e apenas referencia historica — nunca
  /// tarifa vigente.
  effectiveAt DateTime?
  validUntil  DateTime?

  source IndustrialResourceRateSource @default(MANUAL)
  notes  String?

  createdAt             DateTime @default(now())
  createdByUserId       String?
  createdByUser         User?    @relation("IndustrialResourceRateCreatedBy", fields: [createdByUserId], references: [id])
  createdByNameSnapshot String?

  @@index([industrialResourceId])
  @@index([effectiveAt])
  @@map("industrial_resource_rates")
}

/// Uso PLANEJADO de um recurso na base de referencia de uma estrutura.
///
/// O recurso e global; o uso pertence a versao de custo. Uma linha por
/// recurso: sem roteiro/operacoes nesta fase, o mesmo equipamento usado em
/// duas etapas soma o tempo.
model IndustrialCostResourceUsage {
  id String @id @default(uuid())

  industrialCostVersionId String
  industrialCostVersion   IndustrialCostVersion @relation(fields: [industrialCostVersionId], references: [id], onDelete: Cascade)

  industrialResourceId String
  industrialResource   IndustrialResource @relation(fields: [industrialResourceId], references: [id])

  usageBasis    IndustrialResourceUsageBasis @default(FIXED_PER_REFERENCE_BATCH)
  usageQuantity Decimal                      @db.Decimal(18, 6)
  usageUom      IndustrialRateUom

  notes     String?
  sortOrder Int     @default(0)

  /// Snapshot economico congelado na ATIVACAO da versao de custo: mudar a
  /// tarifa ou a potencia amanha nao pode reescrever o que uma estrutura
  /// historica considerou. `null` continua null — tarifa desconhecida
  /// nunca vira zero.
  resourceNameSnapshot    String?
  resourceTypeSnapshot    IndustrialResourceType?
  rateIdSnapshot          String?
  rateValueSnapshot       Decimal?                @db.Decimal(14, 4)
  rateCurrencySnapshot    String?                 @db.VarChar(3)
  rateUomSnapshot         IndustrialRateUom?
  rateEffectiveAtSnapshot DateTime?
  powerKwSnapshot         Decimal?                @db.Decimal(12, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([industrialCostVersionId, industrialResourceId])
  @@index([industrialCostVersionId])
  @@index([industrialResourceId])
  @@map("industrial_cost_resource_usages")
}

/// Calculo do custo industrial CONGELADO para historico e comparacao.
///
/// O calculo em si e determinstico e pode ser refeito a qualquer momento —
/// nao se persiste cada clique. O que se persiste e a ANALISE: daqui a tres
/// meses a media de 30 dias sera outra, e a decisao de preco tomada hoje
/// precisa continuar explicavel. Snapshot salvo nunca recalcula.
model IndustrialCostCalculation {
  id String @id @default(uuid())

  /// CALC-000001 — identidade do documento de calculo.
  code String @unique

  industrialCostVersionId String
  industrialCostVersion   IndustrialCostVersion @relation(fields: [industrialCostVersionId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Data usada para resolver custo de material — nunca "hoje" implicito.
  costReferenceDate DateTime

  /// Calcular sobre rascunho e permitido; a precificacao formal da proxima
  /// capacidade e que vai preferir estrutura ativa.
  structureStatusAtCalculation IndustrialCostVersionStatus

  quality IndustrialCostQuality

  /// Null quando algum componente necessario e desconhecido. Total parcial
  /// NAO existe: existe subtotal conhecido.
  directIndustrialCost Decimal? @db.Decimal(14, 4)
  overheadCost         Decimal? @db.Decimal(14, 4)
  totalIndustrialCost  Decimal? @db.Decimal(14, 4)
  knownSubtotal        Decimal  @db.Decimal(14, 4)
  costPerUnit          Decimal? @db.Decimal(18, 6)
  costPer1000          Decimal? @db.Decimal(14, 4)

  referenceOutputQuantity Decimal @db.Decimal(18, 6)
  referenceOutputUomCode  String

  /// Snapshots do documento — renomear produto/cliente depois nao reescreve
  /// a analise impressa.
  productCodeSnapshot      String
  productNameSnapshot      String
  customerNameSnapshot     String?
  formulationVersionNumber Int

  /// Resultado completo (linhas de material/recurso/premissa, fontes de
  /// custo, avisos) exatamente como foi calculado.
  result Json

  notes String?

  pricingVersions PricingVersion[]

  calculatedAt             DateTime @default(now())
  calculatedByUserId       String?
  calculatedByUser         User?    @relation("IndustrialCostCalculationBy", fields: [calculatedByUserId], references: [id])
  calculatedByNameSnapshot String?

  @@index([industrialCostVersionId])
  @@index([productId])
  @@index([calculatedAt])
  @@map("industrial_cost_calculations")
}

/// Custo industrial de uma producao CONCLUIDA, congelado.
///
/// Materiais sao realizados; recursos/premissas sao custos padrao
/// APLICADOS proporcionalmente ao que foi produzido — a Veridi ainda nao
/// mede horas nem kWh reais, e chamar isso de "real" seria inventar dado.
model ProductionOrderCostSnapshot {
  id String @id @default(uuid())

  productionOrderId String          @unique
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  industrialCostVersionId String?
  industrialCostVersion   IndustrialCostVersion? @relation(fields: [industrialCostVersionId], references: [id])

  formulationVersionNumber Int?

  completedAt      DateTime
  producedQuantity Decimal  @db.Decimal(18, 6)
  outputUnitCode   String

  actualMaterialCostKnown  Decimal  @db.Decimal(14, 4)
  standardAppliedCostKnown Decimal  @db.Decimal(14, 4)
  knownSubtotal            Decimal  @db.Decimal(14, 4)
  totalIndustrialCost      Decimal? @db.Decimal(14, 4)
  costPerProducedUnit      Decimal? @db.Decimal(18, 6)

  quality IndustrialCostQuality

  breakdown Json

  createdAt DateTime @default(now())

  @@index([industrialCostVersionId])
  @@map("production_order_cost_snapshots")
}

/// Precificacao versionada de um produto (PREC-000001 · V2).
///
/// Parte SEMPRE de um calculo de custo salvo: e o CALC que congela EC,
/// formulacao, referencias de material, tarifas e data de referencia. Sem
/// essa proveniencia nao da para dizer "este preco foi construido sobre
/// qual custo", e preco sem origem e chute com aparencia de numero.
model PricingVersion {
  id String @id @default(uuid())

  /// PREC-000001 — identidade do documento.
  code String @unique

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  /// Sequencial POR PRODUTO (V1, V2...), gerado sob lock.
  versionNumber Int

  status PricingVersionStatus @default(DRAFT)

  /// Base economica oficial. Todas as faixas da versao usam a MESMA: uma
  /// compra nova no meio da negociacao nao pode fazer a faixa de 300 e a de
  /// 1000 viverem em realidades diferentes.
  industrialCostCalculationId String
  industrialCostCalculation   IndustrialCostCalculation @relation(fields: [industrialCostCalculationId], references: [id])

  /// Conveniencia historica — o CALC continua sendo a referencia oficial.
  calculationCodeSnapshot            String
  industrialCostVersionLabelSnapshot String
  formulationVersionNumberSnapshot   Int
  costReferenceDateSnapshot          DateTime
  costQualitySnapshot                IndustrialCostQuality

  notes String?

  createdAt             DateTime @default(now())
  createdByUserId       String?
  createdByUser         User?    @relation("PricingVersionCreatedBy", fields: [createdByUserId], references: [id])
  createdByNameSnapshot String?

  activatedAt             DateTime?
  activatedByUserId       String?
  activatedByUser         User?     @relation("PricingVersionActivatedBy", fields: [activatedByUserId], references: [id])
  activatedByNameSnapshot String?

  updatedAt DateTime @updatedAt

  /// POLITICA QUE SERVIU DE MOLDE — proveniencia, nunca vinculo.
  ///
  /// A politica guarda REGRA (faixa, margem alvo, comissao), nunca preco: o
  /// preco depende do custo deste produto e e calculado no momento da
  /// aplicacao. Politica nova nao reescreve precificacao existente.
  originPricingPolicyVersionId     String?
  originPricingPolicyVersion       PricingPolicyTemplateVersion? @relation(fields: [originPricingPolicyVersionId], references: [id], onDelete: SetNull)
  originPricingPolicyCode          String?
  originPricingPolicyVersionNumber Int?

  tiers              PricingTier[]
  quoteLines         QuoteLine[]
  customerOrderLines CustomerOrderLine[] @relation("CustomerOrderLinePricingVersion")

  @@unique([productId, versionNumber])
  @@index([productId])
  @@index([status])
  @@index([industrialCostCalculationId])
  @@index([originPricingPolicyVersionId])
  @@map("pricing_versions")
}

/// Cenario de quantidade dentro de uma precificacao.
///
/// Cada linha e uma QUANTIDADE-BASE explicita (300, 500, 1000 unidades), nao
/// um intervalo: guardar "300-499" daria falsa precisao comercial. O custo
/// unitario muda entre faixas porque custo fixo por lote, caixa inteira e
/// recurso por lote nao diluem linearmente.
model PricingTier {
  id String @id @default(uuid())

  pricingVersionId String
  pricingVersion   PricingVersion @relation(fields: [pricingVersionId], references: [id], onDelete: Cascade)

  quantity Decimal       @db.Decimal(18, 6)
  uomCode  String
  uom      UnitOfMeasure @relation("PricingTierUom", fields: [uomCode], references: [code])

  priceMode PriceMode @default(TARGET_MARGIN)

  /// Percentual (30 = 30%). Null quando o preco e informado manualmente.
  targetContributionMarginPercent Decimal? @db.Decimal(7, 4)
  /// Sobre o preco BRUTO de venda. Zero e zero explicito.
  commissionPercent               Decimal  @default(0) @db.Decimal(7, 4)
  /// Preco informado; null = nao informado (nunca confundido com zero).
  manualUnitPrice                 Decimal? @db.Decimal(14, 6)

  notes     String?
  sortOrder Int     @default(0)

  /// Congelados na ativacao. Depois disso, receber material mais barato ou
  /// reajustar tarifa nao reescreve preco ja negociado.
  costTotalSnapshot           Decimal?               @db.Decimal(14, 4)
  costPerUnitSnapshot         Decimal?               @db.Decimal(18, 6)
  costPer1000Snapshot         Decimal?               @db.Decimal(14, 4)
  knownSubtotalSnapshot       Decimal?               @db.Decimal(14, 4)
  costQualitySnapshot         IndustrialCostQuality?
  batchCountSnapshot          Int?
  targetMarginSnapshot        Decimal?               @db.Decimal(7, 4)
  commissionPercentSnapshot   Decimal?               @db.Decimal(7, 4)
  suggestedPriceSnapshot      Decimal?               @db.Decimal(14, 6)
  selectedPriceSnapshot       Decimal?               @db.Decimal(14, 6)
  commissionPerUnitSnapshot   Decimal?               @db.Decimal(14, 6)
  commissionTotalSnapshot     Decimal?               @db.Decimal(14, 4)
  grossRevenueSnapshot        Decimal?               @db.Decimal(14, 4)
  contributionPerUnitSnapshot Decimal?               @db.Decimal(14, 6)
  contributionTotalSnapshot   Decimal?               @db.Decimal(14, 4)
  contributionMarginSnapshot  Decimal?               @db.Decimal(7, 4)
  markupSnapshot              Decimal?               @db.Decimal(12, 4)
  warningsSnapshot            Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quoteLines         QuoteLine[]
  customerOrderLines CustomerOrderLine[] @relation("CustomerOrderLinePricingTier")

  @@unique([pricingVersionId, quantity])
  @@index([pricingVersionId])
  @@map("pricing_tiers")
}

/// Amostra / piloto / teste Tn de um projeto.
///
/// NAO e Lot nem ProductionOrder: o projeto pode entrar em amostra antes de
/// existir Product, Item de produto acabado ou formulacao operacional —
/// criar Product artificial so para fabricar uma amostra seria mentira no
/// cadastro. A amostra tem identidade propria (`AM-000001`) e QR proprio
/// (`SAMPLE:AM-000001`).
model ProjectSample {
  id String @id @default(uuid())

  /// AM-000001 — identidade interna da amostra.
  code String @unique

  /// Numero/lote da planilha historica, quando existir.
  externalCode String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Produto que a amostra testa, quando o projeto tem mais de um.
  /// Null em amostra legada: nao se inventa associacao que nunca existiu.
  projectProductId String?
  projectProduct   ProjectProduct? @relation(fields: [projectProductId], references: [id])

  /// Sequencial POR PROJETO: T1, T2, T3... Legado preserva o numero
  /// original, e o proximo manual continua depois do maior existente.
  testSequence Int

  status ProjectSampleStatus @default(DRAFT)
  source ProjectSampleSource @default(MANUAL)

  description     String?
  productionNotes String?
  /// Justificativa da decisao — obrigatoria na reprovacao.
  decisionNotes   String?

  /// Quanto foi produzido da amostra. NAO e estoque comercial: amostra
  /// nunca entra em Finished Goods.
  outputQuantity Decimal?       @db.Decimal(18, 6)
  outputUomCode  String?
  outputUom      UnitOfMeasure? @relation("SampleOutputUom", fields: [outputUomCode], references: [code])

  /// Snapshot congelado na producao — editar cliente/projeto depois nao
  /// reescreve a etiqueta ja impressa.
  customerCodeSnapshot String?
  customerNameSnapshot String?
  projectCodeSnapshot  String?
  projectNameSnapshot  String?

  createdAt             DateTime @default(now())
  createdByUserId       String?
  createdByUser         User?    @relation("SampleCreatedBy", fields: [createdByUserId], references: [id])
  createdByNameSnapshot String?

  startedAt             DateTime?
  startedByUserId       String?
  startedByUser         User?     @relation("SampleStartedBy", fields: [startedByUserId], references: [id])
  startedByNameSnapshot String?

  producedAt             DateTime?
  producedByUserId       String?
  producedByUser         User?     @relation("SampleProducedBy", fields: [producedByUserId], references: [id])
  producedByNameSnapshot String?

  approvedAt             DateTime?
  approvedByUserId       String?
  approvedByUser         User?     @relation("SampleApprovedBy", fields: [approvedByUserId], references: [id])
  approvedByNameSnapshot String?

  rejectedAt             DateTime?
  rejectedByUserId       String?
  rejectedByUser         User?     @relation("SampleRejectedBy", fields: [rejectedByUserId], references: [id])
  rejectedByNameSnapshot String?

  cancelledAt             DateTime?
  cancelledByUserId       String?
  cancelledByUser         User?     @relation("SampleCancelledBy", fields: [cancelledByUserId], references: [id])
  cancelledByNameSnapshot String?

  updatedAt DateTime @updatedAt

  consumptions SampleConsumption[]
  attachments  Attachment[]

  @@unique([projectId, testSequence])
  @@index([projectId])
  @@index([status])
  @@map("project_samples")
}

/// Consumo real de material numa amostra. Historico imutavel: reprovar ou
/// cancelar a amostra NUNCA estorna material que ja foi fisicamente usado.
model SampleConsumption {
  id String @id @default(uuid())

  projectSampleId String
  projectSample   ProjectSample @relation(fields: [projectSampleId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  quantity Decimal @db.Decimal(18, 6)
  uomCode  String

  /// 1:1 com o movimento SAMPLE_CONSUMPTION do ledger — a baixa continua
  /// sendo do Inventory Movement, nunca uma segunda contabilidade.
  inventoryMovementId String? @unique

  executedAt             DateTime @default(now())
  executedByUserId       String
  executedByUser         User     @relation("SampleConsumptionBy", fields: [executedByUserId], references: [id])
  executedByNameSnapshot String
  notes                  String?

  @@index([projectSampleId])
  @@index([lotId])
  @@map("sample_consumptions")
}

/// Relacao estavel Item x Fornecedor.
///
/// Preco e MOQ NAO ficam aqui: mudam ao longo do tempo e pertencem a
/// `SupplierItemOffer` (imutavel). Aqui fica o que e estavel: existe a
/// relacao, qual o codigo do item no fornecedor, se esta homologada e se e
/// o fornecedor preferencial.
model SupplierItem {
  id String @id @default(uuid())

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  /// Codigo/referencia que o FORNECEDOR usa para este item. Nao confundir
  /// com Item.code (interno) nem Item.externalCode (planilha legada).
  supplierItemCode String?

  qualificationStatus SupplierItemQualificationStatus @default(PENDING)

  /// Decisao operacional/comercial — NAO significa "mais barato". So
  /// relacao ativa e APPROVED pode ser preferencial, e existe no maximo
  /// uma por Item (indice parcial unico na migration).
  preferred Boolean @default(false)

  /// Diferente de homologacao: o fornecedor pode continuar homologado e
  /// simplesmente ter deixado de comercializar o item.
  active Boolean @default(true)

  commercialNotes String?

  createdAt             DateTime @default(now())
  createdByUserId       String?
  createdByUser         User?    @relation("SupplierItemCreatedBy", fields: [createdByUserId], references: [id])
  createdByNameSnapshot String?

  updatedAt             DateTime @updatedAt
  updatedByUserId       String?
  updatedByUser         User?    @relation("SupplierItemUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedByNameSnapshot String?

  qualificationHistory SupplierItemQualificationHistory[]
  offers               SupplierItemOffer[]

  @@unique([supplierId, itemId])
  @@index([itemId])
  @@index([supplierId])
  @@index([qualificationStatus])
  @@map("supplier_items")
}

/// Historico imutavel de homologacao — quem aprovou/bloqueou e quando.
/// `updatedAt` nao conta historia.
model SupplierItemQualificationHistory {
  id String @id @default(uuid())

  supplierItemId String
  supplierItem   SupplierItem @relation(fields: [supplierItemId], references: [id], onDelete: Cascade)

  fromStatus SupplierItemQualificationStatus?
  toStatus   SupplierItemQualificationStatus
  note       String?

  changedAt             DateTime @default(now())
  changedByUserId       String?
  changedByUser         User?    @relation("SupplierItemQualificationBy", fields: [changedByUserId], references: [id])
  changedByNameSnapshot String?

  @@index([supplierItemId])
  @@map("supplier_item_qualification_history")
}

/// Cotacao/referencia comercial de um fornecedor para um item.
///
/// IMUTAVEL: mudou preco, MOQ, moeda ou vigencia, cria-se uma nova oferta.
/// NAO e custo real de aquisicao (isso continua sendo ReceiptLine) e NAO
/// entra na hierarquia de custo REAL/30D/90D/LAST_REAL/NO_COST.
model SupplierItemOffer {
  id String @id @default(uuid())

  supplierItemId String
  supplierItem   SupplierItem @relation(fields: [supplierItemId], references: [id], onDelete: Cascade)

  /// Sempre informado: preco desconhecido nao gera oferta. Zero e zero
  /// explicito, nunca "nao sei".
  unitPrice    Decimal @db.Decimal(14, 4)
  currencyCode String  @db.VarChar(3)

  /// Unidade a que o preco se refere (R$ 120/kg, R$ 0,15/un).
  priceUomCode String
  priceUom     UnitOfMeasure @relation("OfferPriceUom", fields: [priceUomCode], references: [code])

  /// Pedido minimo faz parte das condicoes DAQUELE preco. `null` significa
  /// nao informado — nunca zero.
  minimumOrderQuantity Decimal?       @db.Decimal(18, 6)
  minimumOrderUomCode  String?
  minimumOrderUom      UnitOfMeasure? @relation("OfferMoqUom", fields: [minimumOrderUomCode], references: [code])

  /// `null` = observacao historica de preco, NAO preco vigente. Oferta sem
  /// vigencia nunca vira Current Offer.
  effectiveAt DateTime?
  validUntil  DateTime?

  source SupplierItemOfferSource @default(MANUAL)

  /// Chave estavel da linha legada — idempotencia do importador.
  sourceKey String? @unique

  notes String?

  createdAt             DateTime @default(now())
  createdByUserId       String?
  createdByUser         User?    @relation("SupplierItemOfferCreatedBy", fields: [createdByUserId], references: [id])
  createdByNameSnapshot String?

  @@index([supplierItemId])
  @@index([effectiveAt])
  @@map("supplier_item_offers")
}

/// Recurso economico da fabrica. Nao e centro de trabalho, roteiro nem
/// ativo patrimonial: e a categoria que recebe tarifa e entra no custo.
enum IndustrialResourceType {
  LABOR
  EQUIPMENT
  ENERGY
}

/// Unidade das tarifas e dos usos industriais.
///
/// Enum proprio, e nao o registro de UOM fisico: hora e kWh nao sao
/// unidades de ITEM. Colocar `h`/`kWh` no registro geral permitiria
/// cadastrar uma materia-prima medida em kWh — o oposto do que o cadastro
/// deve permitir. Aqui a lista e fechada e ligada ao tipo do recurso.
enum IndustrialRateUom {
  HOUR
  KWH
}

enum IndustrialResourceRateSource {
  MANUAL
  LEGACY_IMPORT
}

/// Como o uso planejado se relaciona com a base de referencia.
enum IndustrialResourceUsageBasis {
  FIXED_PER_REFERENCE_BATCH
  PER_OUTPUT_UNIT
  PER_1000_OUTPUT_UNITS
}

/// De onde vem a energia da estrutura de custo.
///
/// `DIRECT` e `FROM_EQUIPMENT` sao mutuamente exclusivos de proposito:
/// somar consumo direto com consumo derivado dos equipamentos contaria a
/// mesma energia duas vezes.
enum EnergyCalculationMode {
  NONE
  DIRECT
  FROM_EQUIPMENT
}

/// Estagio da estrutura de custo industrial. Mesmo ciclo da Formulacao:
/// so o rascunho e editavel, e a versao ativa e um snapshot auditavel.
/// De onde saiu o custo unitario de um material no calculo PROSPECTIVO.
/// Separado de `CostSource` de proposito: la `REAL` significa "custo do lote
/// efetivamente consumido", que so existe quando ha consumo. Custo padrao
/// nunca e real nesse sentido.
enum IndustrialMaterialCostSource {
  WEIGHTED_AVG_30D
  WEIGHTED_AVG_90D
  LAST_REAL
  SUPPLIER_OFFER_PREFERRED
  SUPPLIER_OFFER_SINGLE_APPROVED
  /// Varios homologados com oferta valida e nenhum preferencial: escolher o
  /// menor preco seria tomar decisao comercial no lugar de gente.
  AMBIGUOUS_SUPPLIER_REFERENCE
  NO_COST
  /// Material do cliente: fora do custo Veridi, e isso nao e "desconhecido".
  EXCLUDED_CUSTOMER_SUPPLIED
}

/// Calcular o preco pela margem desejada, ou informar o preco e ver a
/// margem que ele produz.
/// Produto em DESENVOLVIMENTO existe para engenharia e custeio: formulacao,
/// estrutura de custos, calculo e precificacao. Nao entra em pedido,
/// producao comercial, expedicao nem faturamento — so APPROVED opera.
enum ProductLifecycle {
  DEVELOPMENT
  APPROVED
}

/// De onde veio o preco do orcamento: digitado a mao ou de uma faixa de
/// precificacao ativa (com toda a cadeia PREC -> CALC -> EC -> Formulacao).
enum QuotePriceSource {
  MANUAL
  PRICING_TIER
}

enum PriceMode {
  TARGET_MARGIN
  MANUAL_PRICE
}

enum PricingVersionStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum IndustrialCostQuality {
  COMPLETE_REAL_REFERENCE
  COMPLETE_WITH_ESTIMATES
  PARTIAL
  NO_COST
}

/// Producao em andamento ainda pode consumir/produzir mais.
enum RealizedCostStatus {
  PROVISIONAL
  FINAL
}

enum IndustrialCostVersionStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// Categorias de custo INFORMADAS MANUALMENTE nesta fase.
///
/// Materia-prima e embalagem NAO aparecem aqui: elas vem da Formulacao e
/// nunca sao redigitadas como custo manual. Mao de obra, equipamento e
/// energia tambem ficam fora — ganham modelagem propria na capacidade 44,
/// e cria-las como linha manual agora significaria duplicar tudo depois.
enum IndustrialCostCategory {
  SECONDARY_PACKAGING
  THIRD_PARTY_SERVICE
  OVERHEAD
  OTHER
}

/// Como a premissa se converte em custo quando a capacidade 45 calcular.
/// Lista fixa e pequena: nao existe motor de expressao.
enum IndustrialCostBasis {
  FIXED_PER_BATCH
  PER_OUTPUT_UNIT
  PER_1000_OUTPUT_UNITS
  PER_SHIPPING_BOX
  PERCENT_OF_DIRECT_INDUSTRIAL_COST
}

/// Unidades de medida do sistema. Sem tela administrativa no MVP: seed
/// controlado pelo backend (prisma/seed.ts).
///
/// `toBaseFactor` e o fator de conversao para a unidade-base da dimensao
/// (MASS -> g, VOLUME -> L, COUNT -> un), fundacao para conversao entre
/// unidades compativeis quando formulacoes existirem. Conversao entre
/// dimensoes diferentes nunca e permitida.
model UnitOfMeasure {
  code         String       @id
  label        String
  dimension    UomDimension
  toBaseFactor Decimal      @db.Decimal(18, 6)

  items                      Item[]
  offerPrices                SupplierItemOffer[]             @relation("OfferPriceUom")
  offerMoqs                  SupplierItemOffer[]             @relation("OfferMoqUom")
  productsAsDoseUom          Product[]                       @relation("ProductDoseUom")
  projectsAsDoseUom          Project[]                       @relation("ProjectDoseUom")
  quoteLines                 QuoteLine[]                     @relation("QuoteLineUom")
  sampleOutputs              ProjectSample[]                 @relation("SampleOutputUom")
  industrialCostOutputs      IndustrialCostVersion[]         @relation("IndustrialCostOutputUom")
  pricingTiers               PricingTier[]                   @relation("PricingTierUom")
  formulationTemplateOutputs FormulationTemplateVersion[]    @relation("FormulationTemplateOutputUom")
  costTemplateOutputs        IndustrialCostTemplateVersion[] @relation("CostTemplateOutputUom")
  pricingPolicyTiers         PricingPolicyTemplateTier[]     @relation("PricingPolicyTierUom")

  @@map("units_of_measure")
}

/// Homologacao da relacao Item x Fornecedor. E POR ITEM: um fornecedor
/// homologado para acido ascorbico nao esta homologado para tudo.
enum SupplierItemQualificationStatus {
  PENDING
  APPROVED
  BLOCKED
}

enum SupplierItemOfferSource {
  MANUAL
  LEGACY_IMPORT
}

/// Item controlado pela operacao (materia-prima, embalagem ou produto acabado).
/// Cadastro base: sem estoque, fornecedor, preco ou lote fisico neste momento.
model Item {
  id   String   @id @default(uuid())
  type ItemType

  /// Codigo interno gerado pelo backend (sequence dedicada por tipo,
  /// MP-000001 / ME-000001 / PA-000001). Imutavel apos a criacao.
  code String @unique

  name           String
  unitCode       String
  unit           UnitOfMeasure @relation(fields: [unitCode], references: [code])
  controlsLot    Boolean       @default(true)
  controlsExpiry Boolean       @default(true)

  /// Se um lote recebido deste item fica AWAITING_RELEASE (precisa
  /// liberacao da Qualidade) ou ja nasce AVAILABLE. Default por tipo
  /// (ITEM_TYPE_DEFAULTS em @veridi/shared), editavel pelo usuario — nao
  /// inferido permanentemente so pelo type.
  requiresQualityRelease Boolean @default(true)

  /// Se o lote deste item exige laudo/CoA aprovado. Conceito DIFERENTE de
  /// requiresQualityRelease: um item pode exigir laudo sem exigir
  /// liberacao manual e vice-versa. Nunca inferido de um pelo outro.
  requiresCoa Boolean @default(false)

  /// Codigo do sistema legado (planilhas) — reconciliacao da importacao,
  /// nunca identidade operacional.
  externalCode String?

  /// Fonte / forma quimica realmente utilizada (ex.: "Cloridrato de
  /// tiamina" para o item "Vitamina B1"). Texto livre nesta fase — nao
  /// existe entidade Source.
  sourceName String?

  /// Denominacao nutricional declarada (ex.: "Vitamina B1", "Magnesio").
  /// Diferente de `name` quando necessario; embalagem normalmente fica null.
  declaredNutrient String?

  family ItemFamily?

  /// Pureza padrao conhecida da materia-prima, em porcentagem (0 < x <= 100).
  /// `null` significa DESCONHECIDA — nunca deve ser lida como 100%. E apenas
  /// o default para novas formulacoes: a capacidade 34 congelara
  /// `purityPercentApplied` no componente, entao mudar este campo nunca
  /// altera formulacao/OP historica.
  defaultPurityPercent Decimal? @db.Decimal(6, 3)

  /// So para type = PACKAGING; permanece null nos demais tipos.
  packagingSubtype PackagingSubtype?

  externalBarcode String?
  active          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Produto que usa este item (type = FINISHED_PRODUCT) como saida
  /// fisica. 1:1 no MVP — ver Product.finishedProductItemId.
  product Product?

  supplierItems                  SupplierItem[]
  purchaseOrderLines             PurchaseOrderLine[]
  receiptLines                   ReceiptLine[]
  lots                           Lot[]
  inventoryMovements             InventoryMovement[]
  formulationComponents          FormulationComponent[]
  formulationTemplateComponents  FormulationTemplateComponent[]
  sampleConsumptions             SampleConsumption[]
  formulationVersionsAsOutput    FormulationVersion[]
  productionOrderRequirements    ProductionOrderRequirement[]
  productionOrdersAsFinishedItem ProductionOrder[]              @relation("ProductionOrderFinishedItem")
  materialReservationLines       MaterialReservationLine[]
  productionConsumptions         ProductionConsumption[]
  customerOrderReservationLines  CustomerOrderReservationLine[]
  shipmentLines                  ShipmentLine[]
  billingLines                   BillingLine[]

  @@index([type])
  @@index([active])
  @@index([externalBarcode])
  @@index([family])
  @@index([externalCode])
  @@map("items")
}

/// Fornecedor. Cadastro base: sem preco, avaliacao, dados bancarios ou
/// vinculo com Item neste momento (entra em Compras/Recebimento).
model Supplier {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, FOR-000001).
  /// Imutavel apos a criacao.
  code String @unique

  legalName String
  tradeName String?

  /// Somente digitos. Unicidade (quando informado) garantida por indice
  /// parcial na migration — Prisma nao modela unique index parcial.
  cnpj  String?
  email String?
  phone String?
  notes String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierItems  SupplierItem[]
  purchaseOrders PurchaseOrder[]
  receipts       Receipt[]
  lots           Lot[]

  @@index([active])
  @@map("suppliers")
}

/// Familia industrial do Item — classificacao operacional usada pelo
/// cadastro e pelas futuras capacidades de formulacao/custeio. Lista fixa
/// nesta fase: nao existe cadastro configuravel de familias.
enum ItemFamily {
  VITAMIN
  MINERAL
  AMINO_ACID
  EXCIPIENT
  BOTANICAL
  OTHER_RAW_MATERIAL
  PACKAGING
  OTHER
}

/// Subtipo de embalagem. So faz sentido para Item.type = PACKAGING —
/// coerencia validada no service.
enum PackagingSubtype {
  POT
  CAP
  SCOOP
  SEAL
  LABEL
  BOX
  POUCH
  CARTON
  BOTTLE
  OTHER
}

/// Forma farmaceutica do Product.
enum DosageForm {
  CAPSULE
  POWDER
  TABLET
  LIQUID
  OTHER
}

/// Apresentacao comercial do Product — NAO confundir com o Item de
/// embalagem usado na formulacao.
enum PresentationType {
  POT
  POUCH
  CARTON
  BULK
  BOTTLE
  OTHER
}

/// Publico-alvo declarado. Nesta fase e apenas cadastro descritivo:
/// nenhuma regra regulatoria (IDR/%VD/ANVISA) depende dele — isso e o
/// gate do Bloco H.
enum TargetAgeGroup {
  ADULT
  CHILD
  PREGNANT
  LACTATING
  OTHER
}

/// Cliente. Cadastro base: sem CRM, tabela de preco ou pedido neste momento.
model Customer {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, CLI-000001).
  /// Imutavel apos a criacao.
  code String @unique

  legalName String
  tradeName String?

  /// Somente digitos. Unicidade (quando informado) garantida por indice
  /// parcial na migration — Prisma nao modela unique index parcial.
  cnpj  String?
  email String?
  phone String?

  /// Codigo do sistema legado (planilhas). Serve para importacao e
  /// reconciliacao — NUNCA substitui `code`, que continua sendo a
  /// identidade operacional do ERP.
  externalCode String?

  /// Endereco estruturado. Todos opcionais: clientes cadastrados antes da
  /// capacidade 33 continuam validos com os campos em null.
  street     String?
  number     String?
  complement String?
  district   String?
  /// Somente digitos quando informado (a formatacao 00000-000 e da UI).
  zipCode    String?
  city       String?

  /// UF brasileira, sempre maiuscula.
  state String?
  notes String?

  active Boolean @default(true)

  /// Autoria do cadastro. Nullable de proposito: cliente criado antes desta
  /// capacidade (ou importado do legado) nao tem autor conhecido, e inventar
  /// um seria pior que exibir "Nao disponivel".
  createdAt             DateTime @default(now())
  createdByUserId       String?
  createdByUser         User?    @relation("CustomerCreatedBy", fields: [createdByUserId], references: [id])
  createdByNameSnapshot String?

  updatedAt             DateTime @updatedAt
  updatedByUserId       String?
  updatedByUser         User?    @relation("CustomerUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedByNameSnapshot String?

  /// Sufixo do lote comercial deste cliente (ex.: "A3"). So alimenta a
  /// SUGESTAO de businessLotNumber — nunca obriga nem valida.
  businessLotSuffix String?

  products         Product[]
  customerOrders   CustomerOrder[]
  ownedLots        Lot[]
  receipts         Receipt[]
  productionOrders ProductionOrder[]
  projects         Project[]

  @@index([active])
  @@index([externalCode])
  @@map("customers")
}

/// Definicao comercial/industrial do produto fabricado pela Veridi.
/// Distinto de Item: Item e a entidade fisica controlada em estoque
/// (inclusive o Item FINISHED_PRODUCT correspondente); Product e a
/// definicao comercial a que pertencerao formulacoes e OPs no futuro.
/// Cadastro base: sem formulacao, OP, preco ou multiplos SKUs neste momento.
model Product {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, PROD-000001).
  /// Imutavel apos a criacao.
  code String @unique

  name String

  /// Cliente opcional. Associacao historica preservada mesmo se o
  /// Customer for inativado depois — regra de negocio validada no service,
  /// nao no schema.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// Item FINISHED_PRODUCT opcional, 1:1 (unique mesmo sendo nullable —
  /// Postgres permite multiplos NULL em indice unique, sem precisar de
  /// indice parcial). type/active validados no service na criacao do
  /// vinculo; associacao historica preservada se o Item for inativado depois.
  finishedProductItemId String? @unique
  finishedProductItem   Item?   @relation(fields: [finishedProductItemId], references: [id])

  /// Perfil industrial (capacidade 33). Todos opcionais: produtos
  /// cadastrados antes continuam validos. Nenhum deles altera calculo de
  /// estoque/producao — sao cadastro, insumo para as capacidades 34-47.
  dosageForm       DosageForm?
  presentationType PresentationType?

  /// Quantidade de capsulas por dose (normalmente com dosageForm CAPSULE).
  capsulesPerDose Int?

  /// Dose declarada (ex.: 500 mg). `doseUom` existe porque a unidade da
  /// dose pode ser diferente da unidade de estoque do Finished Item.
  doseAmount  Decimal?       @db.Decimal(18, 6)
  doseUomCode String?
  doseUom     UnitOfMeasure? @relation("ProductDoseUom", fields: [doseUomCode], references: [code])

  dosesPerPackage     Int?
  unitsPerShippingBox Int?

  /// Publico-alvo — descritivo nesta fase, sem regra regulatoria.
  targetAgeGroup TargetAgeGroup?

  /// Vida util padrao em meses. A capacidade 36 podera sugerir
  /// `validade = data de producao + shelfLifeMonths`; aqui e so cadastro.
  shelfLifeMonths Int?

  /// Lote minimo de fabricacao, na unidade do Finished Product Item —
  /// por isso nao existe `minimumBatchUom`. Nao bloqueia OP nesta fase.
  minimumBatchQuantity Decimal? @db.Decimal(18, 6)

  /// Codigo do produto dentro da mascara de lote comercial (ex.: "0340").
  /// So alimenta a SUGESTAO de businessLotNumber.
  businessLotCode String?

  externalCode String?
  notes        String?
  active       Boolean @default(true)

  /// Produto tecnico do projeto (DEVELOPMENT) x produto operacional
  /// (APPROVED). O produto NAO muda de identidade ao ser aprovado: mesmo
  /// codigo, mesma formulacao, mesma estrutura de custos.
  lifecycle ProductLifecycle @default(APPROVED)

  /// Projeto que criou este produto tecnico. So existe para produto nascido
  /// da acao "preparar produto tecnico" — produto legado continua null e
  /// nunca e afetado pelo cancelamento de um projeto.
  /// Projeto que originou o produto. NAO e unico: um projeto multiproduto
  /// faz nascer varios produtos, e todos apontam para ele.
  originProjectId String?
  originProject   Project? @relation("ProductOriginProject", fields: [originProjectId], references: [id])

  /// Projetos em que este produto participa. `originProject` diz onde ele
  /// NASCEU; isto diz onde ele e negociado.
  projectProducts ProjectProduct[]
  quoteLines      QuoteLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formulationVersions           FormulationVersion[]
  industrialCostVersions        IndustrialCostVersion[]
  industrialCostCalculations    IndustrialCostCalculation[]
  pricingVersions               PricingVersion[]
  productionOrders              ProductionOrder[]
  customerOrderLines            CustomerOrderLine[]
  attachments                   Attachment[]
  project                       Project?
  customerOrderReservationLines CustomerOrderReservationLine[]
  shipmentLines                 ShipmentLine[]
  billingLines                  BillingLine[]

  @@index([active])
  @@index([customerId])
  @@map("products")
}

/// Versao de formulacao — pertence ao Product, nao ao Item de saida
/// diretamente. DRAFT e editavel; ACTIVE/INACTIVE sao imutaveis por
/// construcao (nenhuma rota de edicao aceita nesses status). No maximo uma
/// ACTIVE por Product (garantido tambem por indice unico parcial na
/// migration). Mudar a formulacao sempre cria uma nova versao — nunca
/// edita uma ACTIVE.
model FormulationVersion {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Sequencial por Product (V1, V2...) — NAO e uma sequence global.
  versionNumber Int

  status FormulationVersionStatus @default(DRAFT)

  /// "Estas quantidades de componentes produzem `basisQuantity` do produto
  /// acabado" — base de calculo, futura fundacao do Requirement Calculation
  /// da OP (nao implementado ainda).
  basisQuantity Decimal @db.Decimal(18, 6)

  /// Modo de calculo da versao. FIXED_BASIS preserva o comportamento
  /// original; PER_DOSE declara a formula por DOSE do produto acabado, do
  /// jeito que a industria trabalha.
  calculationMode FormulationCalculationMode @default(FIXED_BASIS)

  /// Doses por embalagem — obrigatorio no modo PER_DOSE, nulo no
  /// FIXED_BASIS. E o elo entre "mg por dose" e a unidade vendida.
  dosesPerPackage Int?

  /// Snapshot do output no momento da criacao/copia da versao — nunca
  /// depende da associacao ATUAL do Product (que pode mudar depois),
  /// preservando o significado historico da versao.
  outputItemId   String
  outputItem     Item   @relation(fields: [outputItemId], references: [id])
  outputItemCode String
  outputItemName String
  outputUnitCode String

  notes String?

  createdAt DateTime @default(now())
  createdBy String?

  activatedAt DateTime?
  activatedBy String?

  inactivatedAt DateTime?
  inactivatedBy String?

  /// Versao que serviu de molde para esta. Null na V1 e em versoes criadas
  /// antes deste campo existir. Guardado porque, meses depois, um salto de
  /// custo entre V2 e V3 sem origem declarada nao tem explicacao possivel.
  sourceVersionId     String?
  sourceVersion       FormulationVersion? @relation("FormulationVersionSource", fields: [sourceVersionId], references: [id])
  /// Numero da versao de origem, gravado junto: o rotulo e historico e nao
  /// deve depender de join para existir.
  sourceVersionNumber Int?

  /// TEMPLATE QUE SERVIU DE MOLDE — provenance, nunca vinculo vivo.
  ///
  /// Usar um template COPIA os dados para esta versao. Depois disso as duas
  /// seguem independentes: o template pode ganhar V4 e esta formulacao
  /// continua sendo o que era. Nada aqui se sincroniza, por decisao — um
  /// cliente nao pode ter a receita mudada porque outro cliente pediu algo.
  ///
  /// Null em toda formulacao criada em branco, copiada de outra versao do
  /// mesmo produto, ou anterior a esta capacidade.
  originTemplateVersionId     String?
  originTemplateVersion       FormulationTemplateVersion? @relation(fields: [originTemplateVersionId], references: [id], onDelete: SetNull)
  /// Codigo e numero gravados junto: o rotulo "criada a partir de FT-000008
  /// V3" e historico e nao deve depender de join para existir.
  originTemplateCode          String?
  originTemplateVersionNumber Int?

  components             FormulationComponent[]
  derivedVersions        FormulationVersion[]    @relation("FormulationVersionSource")
  industrialCostVersions IndustrialCostVersion[]
  productionOrders       ProductionOrder[]

  /// V1/V2/... e sempre unico dentro do mesmo Product.
  @@unique([productId, versionNumber])
  @@index([productId])
  @@index([status])
  @@index([originTemplateVersionId])
  @@map("formulation_versions")
}

/// Linha de componente (materia-prima/embalagem) de uma versao de
/// formulacao. So existe/muda enquanto a versao e DRAFT.
model FormulationComponent {
  id String @id @default(uuid())

  formulationVersionId String
  formulationVersion   FormulationVersion @relation(fields: [formulationVersionId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Significado depende de `basis`: quantidade para a base da versao
  /// (FIXED_BASIS), por dose (PER_DOSE) ou por unidade acabada
  /// (PER_FINISHED_UNIT — embalagem).
  quantity Decimal @db.Decimal(18, 6)

  /// Pode diferir da unidade de estoque do Item, desde que mesma dimensao
  /// (ex.: item em kg, componente em g) — validado via lib/uom existente.
  unitCode String

  basis FormulationComponentBasis @default(FIXED_BASIS)

  /// Responsabilidade de fornecimento — congelada na versao junto com o
  /// resto. Mudar depois nunca reescreve uma versao ACTIVE historica.
  supplyResponsibility SupplyResponsibility @default(VERIDI)

  /// SNAPSHOT da pureza aplicada nesta formulacao (0 < x <= 100). Copiada
  /// de Item.defaultPurityPercent quando existir no momento da criacao —
  /// alterar o Item depois NUNCA muda esta versao. `null` = pureza
  /// desconhecida: nenhuma correcao e aplicada (jamais assume 100% para
  /// "consertar" o numero).
  purityPercentApplied Decimal? @db.Decimal(6, 3)

  /// Perda/excesso de processo em % (>= 0). `null` = nao informado; nunca
  /// e inferido matematicamente so para bater com um total historico.
  overagePercent Decimal? @db.Decimal(6, 3)

  /// Referencia historica da planilha (total que a fabrica pesava e o
  /// tamanho do lote correspondente). NUNCA entra no calculo — existe para
  /// comparar ERP x historico durante a migracao.
  legacyTotalQuantity Decimal? @db.Decimal(18, 6)
  legacyTotalUnitCode String?
  legacyBatchUnits    Decimal? @db.Decimal(18, 6)

  notes String?

  /// Ordem de exibicao estavel — nao depende da ordem de insercao no banco.
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mesmo Item nao pode aparecer duas vezes na mesma versao.
  @@unique([formulationVersionId, itemId])
  @@map("formulation_components")
}

/// Ordem de Compra — primeira feature transacional. DRAFT e livremente
/// editavel; ao confirmar (ORDERED) o conteudo (fornecedor/itens/
/// quantidades/precos) fica congelado — so previsao de entrega e
/// observacoes continuam editaveis. Sem exclusao fisica; cancelar preserva
/// o documento no historico.
model PurchaseOrder {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, OC-000001).
  /// Imutavel apos a criacao.
  code String @unique

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  /// Snapshot do fornecedor no momento do pedido. Acompanha edicoes
  /// enquanto DRAFT (revalidado a cada save); congela ao confirmar.
  /// Fonte de verdade para exibir o documento, independente de mudancas
  /// futuras no cadastro de Supplier.
  supplierCode String
  supplierName String
  supplierCnpj String?

  orderDate            DateTime
  expectedDeliveryDate DateTime?

  status PurchaseOrderStatus @default(DRAFT)
  notes  String?

  origin PurchaseOrderOrigin @default(MANUAL)

  /// Preenchido so quando origin = CUSTOMER_ORDER — a OC nasce DRAFT e
  /// segue o fluxo normal (nunca ORDERED automatico). Vinculo permite
  /// navegar Pedido -> OC e OC -> Pedido.
  customerOrderId String?
  customerOrder   CustomerOrder? @relation(fields: [customerOrderId], references: [id])

  orderedAt DateTime?
  orderedBy String?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  lines    PurchaseOrderLine[]
  receipts Receipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierId])
  @@index([customerOrderId])
  @@map("purchase_orders")
}

/// Linha de Ordem de Compra. So existem/mudam enquanto a OC e DRAFT —
/// congeladas junto com o documento ao confirmar.
model PurchaseOrderLine {
  id String @id @default(uuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Snapshot do item no momento da linha — mesma logica do supplier acima.
  itemCode String
  itemName String
  unitCode String

  orderedQuantity Decimal @db.Decimal(18, 6)

  /// PRECO PREVISTO/NEGOCIADO — nunca custo real nem valor pago. Serve
  /// como referencia visual no Recebimento, mas o custo so vira real
  /// quando informado explicitamente em ReceiptLine.actualUnitCost.
  /// Nunca alimenta as medias de custo real.
  unitPrice Decimal? @db.Decimal(14, 4)

  receiptLines ReceiptLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mesmo Item nao pode aparecer duas vezes na mesma OC (MVP).
  @@unique([purchaseOrderId, itemId])
  @@map("purchase_order_lines")
}

/// Evento de recebimento CONFIRMADO de uma Ordem de Compra. Sem DRAFT
/// persistido — o frontend monta tudo e confirma de uma vez. Historico/
/// somente-leitura depois de criado; nunca excluido.
///
/// Nao duplica snapshot de fornecedor: reaproveita o snapshot ja congelado
/// em PurchaseOrder (supplierCode/supplierName/supplierCnpj), suficiente
/// e imutavel. supplierId fica aqui so para filtro direto.
model Receipt {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, REC-000001).
  code String @unique

  sourceType ReceiptSourceType @default(PURCHASE_ORDER)

  /// Preenchidos so quando sourceType=PURCHASE_ORDER — recebimento de
  /// material do cliente nao inventa OC nem fornecedor.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  /// Obrigatorio quando sourceType=CUSTOMER_SUPPLIED — dono do material
  /// recebido (CHECK no banco).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  receivedAt        DateTime
  invoiceNumber     String?
  documentReference String?
  notes             String?

  lines ReceiptLine[]

  createdAt DateTime @default(now())
  createdBy String?

  attachments Attachment[]

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([customerId])
  @@map("receipts")
}

/// Linha de recebimento — quanto de uma PurchaseOrderLine chegou fisicamente
/// neste Receipt. Item code/nome ja estao congelados na PurchaseOrderLine
/// vinculada; nao duplica aqui.
model ReceiptLine {
  id String @id @default(uuid())

  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  /// Null em recebimento de material do cliente — a linha e direta, sem
  /// OC. Para linhas de OC continua obrigatorio na pratica.
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Snapshot do item na linha. Linhas antigas de OC ficaram com null e
  /// continuam lendo o snapshot da PurchaseOrderLine — nunca reescritas.
  itemCode String?
  itemName String?

  receivedQuantity Decimal @db.Decimal(18, 6)
  unitCode         String

  /// Identificacao do fornecedor para o lote — nunca substituida pelo
  /// nosso codigo interno. Obrigatoria quando Item.controlsLot=true.
  supplierLot String?

  /// Obrigatoria quando Item.controlsExpiry=true; nunca anterior a receivedAt.
  expiryDate DateTime?

  /// Local fisico simples (string livre) — sem Warehouse/Zone/Bin ainda.
  location String?

  /// Preenchido apos a criacao do Lot (mesma transacao) quando
  /// Item.controlsLot=true. Null quando o item nao controla lote.
  lotId String? @unique
  lot   Lot?    @relation(fields: [lotId], references: [id])

  /// CUSTO EFETIVO DE AQUISICAO por unidade de estoque do Item. Nunca
  /// copiado automaticamente de PurchaseOrderLine.unitPrice (que e so
  /// preco previsto/negociado) e nunca confundido com valor pago (camada
  /// financeira futura). `null` = desconhecido; `0` e um valor
  /// explicitamente informado, nunca reinterpretado como desconhecido.
  /// Nomeado "de aquisicao" para no futuro comportar mercadoria + frete +
  /// despesas diretamente atribuiveis, sem quebrar o schema.
  actualUnitCost Decimal?  @db.Decimal(14, 4)
  costUpdatedAt  DateTime?
  costUpdatedBy  String?
  costNote       String?

  createdAt DateTime @default(now())

  /// 1:1 com o InventoryMovement RECEIPT_IN gerado ao confirmar o
  /// recebimento — ver InventoryMovement.receiptLineId.
  inventoryMovement InventoryMovement?

  @@index([purchaseOrderLineId])
  @@index([itemId])
  @@map("receipt_lines")
}

/// Lote interno — criado automaticamente quando Item.controlsLot=true, seja
/// por Recebimento (origin=RECEIPT) ou por Producao (origin=PRODUCTION).
/// Mesma infraestrutura para as duas origens — nunca um segundo modelo de
/// lote so para produto acabado. `initialReceivedQuantity` e so o quanto
/// entrou no evento que criou o lote (recebimento OU primeira producao):
/// NAO e saldo atual. Saldo fisico vem do ledger de Inventory Movements.
model Lot {
  id String @id @default(uuid())

  /// LT-YYYYMMDD-NNNNNN — data do evento (recebimento ou producao) +
  /// sequence global (nao reinicia por dia). Gerado pelo backend,
  /// imutavel, unico. Mesmo identificador usado no QR interno para as
  /// duas origens.
  code String @unique

  origin LotOrigin @default(RECEIPT)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Obrigatorio para origin=RECEIPT; sempre null para origin=PRODUCTION —
  /// nunca fornecedor fake so para preencher a coluna.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  /// DONO do estoque fisico — independente de Supplier (quem vendeu) e de
  /// quem enviou. VERIDI exige ownerCustomerId null; CUSTOMER exige
  /// ownerCustomerId preenchido (CHECK no banco). Imutavel apos a criacao:
  /// nao existe troca de propriedade nesta fase.
  ownerType       InventoryOwnerType @default(VERIDI)
  ownerCustomerId String?
  ownerCustomer   Customer?          @relation(fields: [ownerCustomerId], references: [id])

  receiptLine ReceiptLine?

  /// Preenchido so para origin=PRODUCTION — a OP que produziu este lote.
  /// Nunca junto com supplierId.
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  /// Lote comercial/Veridi — informado pelo usuario ao criar um lote de
  /// producao, permanece historico (nunca sobrescrito). Nunca substitui
  /// `code` (identidade interna) nem `supplierLot` (identificacao do
  /// fornecedor). Sem algoritmo automatico ainda — decisao futura.
  businessLotNumber String?

  /// So para origin=RECEIPT — identificacao do fornecedor, nunca
  /// preenchida para lote produzido.
  supplierLot String?
  expiryDate  DateTime?

  initialReceivedQuantity Decimal @db.Decimal(18, 6)

  status   LotStatus @default(AVAILABLE)
  location String?

  /// SNAPSHOT da exigencia documental no momento em que o lote nasceu.
  /// As regras do lote usam este campo, nunca `Item.requiresCoa` atual:
  /// mudar o cadastro amanha nao pode reclassificar lotes historicos.
  requiresCoaSnapshot Boolean   @default(false)
  coaStatus           CoaStatus @default(NOT_REQUIRED)

  coaReviewedAt             DateTime?
  coaReviewedByUserId       String?
  coaReviewedByUser         User?     @relation("CoaReviewedBy", fields: [coaReviewedByUserId], references: [id])
  coaReviewedByNameSnapshot String?
  coaReviewNote             String?

  releasedAt DateTime?
  releasedBy String?

  blockedAt   DateTime?
  blockedBy   String?
  blockReason String?

  createdAt DateTime @default(now())
  createdBy String?

  inventoryMovements            InventoryMovement[]
  materialReservationLines      MaterialReservationLine[]
  productionConsumptions        ProductionConsumption[]
  productionOutputs             ProductionOutput[]
  customerOrderReservationLines CustomerOrderReservationLine[]
  shipmentLines                 ShipmentLine[]
  billingLines                  BillingLine[]
  recipeWeighings               RecipeWeighing[]
  sampleConsumptions            SampleConsumption[]
  attachments                   Attachment[]

  @@index([itemId])
  @@index([supplierId])
  @@index([status])
  @@index([productionOrderId])
  @@index([ownerCustomerId])
  @@index([coaStatus])
  @@map("lots")
}

/// Ledger de movimentacoes fisicas de estoque — fonte de verdade das
/// quantidades (On Hand = soma algebrica por item/lote). Historico
/// imutavel: nunca editado/excluido; erro operacional se corrige com novo
/// movimento compensatorio. Lot.initialReceivedQuantity NAO e saldo — o
/// saldo sempre vem daqui.
model InventoryMovement {
  id String @id @default(uuid())

  /// onDelete Cascade so importa para limpeza de fixture de teste — em
  /// producao Item/Lot/ReceiptLine nunca sao excluidos fisicamente.
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Null quando o item nao controla lote (Item.controlsLot = false).
  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id], onDelete: Cascade)

  type InventoryMovementType

  /// Sempre positivo (magnitude) — o sinal na soma do On Hand vem do
  /// `type` (RECEIPT_IN/ADJUSTMENT_IN = +, ADJUSTMENT_OUT/LOSS = -), nunca
  /// de um valor negativo armazenado.
  quantity Decimal @db.Decimal(18, 6)

  occurredAt DateTime

  sourceType InventoryMovementSourceType
  sourceId   String?

  /// Preenchido so para RECEIPT_IN — FK real 1:1 com ReceiptLine, garante
  /// no banco que um ReceiptLine confirmado gera no maximo um RECEIPT_IN.
  receiptLineId String?      @unique
  receiptLine   ReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)

  /// Preenchido so para PRODUCTION_CONSUMPTION — FK real 1:1, garante no
  /// banco que um ProductionConsumption gera no maximo um movimento.
  productionConsumptionId String?                @unique
  productionConsumption   ProductionConsumption? @relation(fields: [productionConsumptionId], references: [id], onDelete: Cascade)

  /// Preenchido so para FINISHED_GOOD_PRODUCTION — FK real 1:1, garante no
  /// banco que um ProductionOutput gera no maximo um movimento.
  productionOutputId String?           @unique
  productionOutput   ProductionOutput? @relation(fields: [productionOutputId], references: [id], onDelete: Cascade)

  /// Preenchido so para SHIPMENT_OUT — FK real 1:1, garante no banco que
  /// uma ShipmentLine confirmada gera no maximo um movimento de saida.
  shipmentLineId String?       @unique
  shipmentLine   ShipmentLine? @relation(fields: [shipmentLineId], references: [id], onDelete: Cascade)

  /// Obrigatorio (validado no service) para ajuste/perda; sempre null em RECEIPT_IN.
  reason String?

  createdBy String?
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([lotId])
  @@index([type])
  @@index([occurredAt])
  @@map("inventory_movements")
}

/// Ordem de Producao. DRAFT e livremente editavel (Product/Formulacao/
/// quantidade/notas), regenerando Requirements a cada mudanca relevante.
/// PLANNED congela Product/versao de formulacao/quantidade/Requirements —
/// so notas continuam editaveis. Sem exclusao fisica; cancelar preserva o
/// documento e os Requirements no historico.
model ProductionOrder {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, OP-000001).
  /// Imutavel apos a criacao.
  code String @unique

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Null enquanto DRAFT sem formulacao definida (produto sem ACTIVE, ou
  /// ainda nao escolhida). Pode referenciar qualquer versao do Product
  /// durante DRAFT (para prever Requirements); PLAN exige que a versao
  /// esteja ACTIVE no momento.
  formulationVersionId String?
  formulationVersion   FormulationVersion? @relation(fields: [formulationVersionId], references: [id])

  /// Estrutura de custos congelada no RELEASE, quando existe uma ACTIVE
  /// compativel com a formulacao da OP. Null e situacao legitima: producao
  /// nunca depende de custo estruturado, e OPs antigas continuam validas.
  industrialCostVersionId String?
  industrialCostVersion   IndustrialCostVersion? @relation("ProductionOrderCostVersion", fields: [industrialCostVersionId], references: [id])

  plannedQuantity Decimal @db.Decimal(18, 6)
  outputUnitCode  String

  status ProductionOrderStatus @default(DRAFT)
  origin ProductionOrderOrigin @default(MANUAL)

  /// Preenchidos so quando origin = CUSTOMER_ORDER — a OP nasce DRAFT e
  /// segue o fluxo normal (PLAN/RELEASE manuais), nunca pula etapa por
  /// causa da origem. customerOrderLineId identifica a linha especifica
  /// atendida (uma OP por linha nesta fase).
  customerOrderId String?
  customerOrder   CustomerOrder? @relation(fields: [customerOrderId], references: [id])

  customerOrderLineId String?
  customerOrderLine   CustomerOrderLine? @relation(fields: [customerOrderLineId], references: [id])

  notes String?

  /// Snapshot historico — preenchido so ao planejar (PLANNED). Enquanto
  /// DRAFT, o service le Product/FormulationVersion/Item ao vivo via join.
  productCode String?
  productName String?

  finishedItemId   String?
  finishedItem     Item?   @relation("ProductionOrderFinishedItem", fields: [finishedItemId], references: [id])
  finishedItemCode String?
  finishedItemName String?

  formulationVersionNumber Int?

  /// Cliente da OP — resolvido do CustomerOrder (origin=CUSTOMER_ORDER) ou
  /// do Product. Necessario para usar material de propriedade do cliente.
  /// Nunca reescrito quando Product.customerId mudar depois.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerCode String?
  customerName String?
  customerCnpj String?

  /// Snapshot completo do cliente para o documento impresso — congelado no
  /// RELEASE. Editar o cadastro depois nunca reescreve a OP.
  customerTradeName  String?
  customerZipCode    String?
  customerStreet     String?
  customerNumber     String?
  customerComplement String?
  customerDistrict   String?
  customerCity       String?
  customerState      String?

  /// Numeracao OFICIAL anual do documento (ex.: "023/26"), gerada na
  /// primeira transicao para RELEASED. `code` (OP-000001) continua sendo a
  /// identidade interna — os dois convivem.
  officialNumber         String? @unique
  officialNumberYear     Int?
  officialNumberSequence Int?

  /// Em quantas partes/fracoes a producao sera executada. Congelado no
  /// RELEASE: folha de receita e execucao dependem disso.
  numberOfParts Int @default(1)

  /// Observacoes de rotulagem para a impressao do lote. Texto livre,
  /// editavel ate o RELEASE.
  labelInstructions String?

  /// Revisoes dos documentos controlados congeladas no RELEASE — mudar a
  /// revisao ativa global depois nunca altera uma OP ja liberada.
  productionOrderRevisionId String?
  productionOrderRevision   ControlledDocumentRevision? @relation("ProductionOrderDocumentRevision", fields: [productionOrderRevisionId], references: [id])

  recipeSheetRevisionId String?
  recipeSheetRevision   ControlledDocumentRevision? @relation("RecipeSheetDocumentRevision", fields: [recipeSheetRevisionId], references: [id])

  plannedAt DateTime?
  plannedBy String?

  /// Preenchido em PLANNED -> RELEASED. Reservation e a alocacao oficial
  /// criada nesse momento — ver MaterialReservation.
  releasedAt DateTime?
  releasedBy String?

  /// Preenchido no PRIMEIRO consumo real confirmado (RELEASED ->
  /// IN_PRODUCTION). Nao existe botao "Iniciar producao" separado — o
  /// primeiro Consumo confirmado e o que caracteriza o inicio.
  startedAt DateTime?
  startedBy String?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  /// Preenchidos em IN_PRODUCTION -> COMPLETED. completionReason e
  /// obrigatorio so quando producedQuantity < plannedQuantity (variancia).
  completedAt      DateTime?
  completedBy      String?
  completionReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements ProductionOrderRequirement[]
  parts        ProductionOrderPart[]

  /// No maximo uma reserva operacional por OP, criada no RELEASE. Nunca
  /// recriada mesmo se a OP RELEASED for cancelada (fica historica).
  reservation MaterialReservation?

  consumptions ProductionConsumption[]

  /// Eventos reais de producao parcial — producedQuantity e sempre a soma
  /// destes, nunca uma segunda coluna manual.
  outputs      ProductionOutput[]
  costSnapshot ProductionOrderCostSnapshot?

  /// Lotes de produto acabado gerados por esta OP (origin=PRODUCTION).
  finishedLots Lot[]

  @@index([status])
  @@index([productId])
  @@index([customerOrderId])
  @@index([customerId])
  @@map("production_orders")
}

/// Necessidade de material CONGELADA da OP — nunca guarda On Hand/
/// Reserved/Available/On Order/Shortage (isso e sempre calculado ao vivo
/// na leitura, a partir do Inventory Ledger). Regenerada (delete+recreate)
/// a cada mudanca relevante enquanto a OP e DRAFT; congelada ao planejar.
model ProductionOrderRequirement {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Snapshot — mesmo padrao de linha de documento historico.
  itemCode String
  itemName String
  itemType ItemType

  /// Quantidade/unidade originais da formula (component.quantity/unitCode).
  formulaQuantity Decimal @db.Decimal(18, 6)
  formulaUnitCode String

  /// SNAPSHOT da responsabilidade de fornecimento vinda do
  /// FormulationComponent. A OP nunca volta a consultar a formulacao atual
  /// para decidir de quem o material deveria vir.
  supplyResponsibility SupplyResponsibility @default(VERIDI)

  /// Necessidade TEORICA (antes de pureza/overage), na unidade de estoque.
  theoreticalQuantity Decimal? @db.Decimal(18, 6)

  /// Pureza/overage efetivamente aplicados — congelados junto com a OP.
  purityPercentApplied Decimal? @db.Decimal(6, 3)
  overagePercent       Decimal? @db.Decimal(6, 3)

  /// Necessidade FISICA final (ja com pureza/overage), convertida para a
  /// unidade de estoque do Item — fonte de verdade da necessidade da OP.
  requiredQuantity Decimal @db.Decimal(18, 6)
  stockUnitCode    String

  /// Ordem de exibicao estavel.
  position Int

  createdAt DateTime @default(now())

  reservationLines MaterialReservationLine[]
  consumptions     ProductionConsumption[]
  recipeWeighings  RecipeWeighing[]

  @@unique([productionOrderId, itemId])
  @@map("production_order_requirements")
}

/// Reserva de materiais criada no RELEASE da OP — a partir daqui Reserved
/// deixa de ser 0 fixo e passa a ser a soma real das linhas ACTIVE. Nunca
/// altera On Hand, nunca cria InventoryMovement. Nunca deletada — historico
/// (ACTIVE conta em Reserved; RELEASED nao conta mais).
model MaterialReservation {
  id String @id @default(uuid())

  /// No maximo uma por OP (garantido no banco) — reserva nasce so pela
  /// regra de dominio do RELEASE, nunca por endpoint generico.
  productionOrderId String          @unique
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])

  status MaterialReservationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  createdBy String?

  /// Preenchidos quando a reserva e liberada (ex.: cancelamento da OP
  /// RELEASED) — nunca por desreserva manual, nao implementada nesta fase.
  releasedAt    DateTime?
  releasedBy    String?
  releaseReason String?

  lines MaterialReservationLine[]

  @@index([status])
  @@map("material_reservations")
}

/// Alocacao oficial por item/lote de uma reserva — base do futuro Picking.
/// Item sem controle de lote: lotId null, quantidade no nivel do Item.
model MaterialReservationLine {
  id String @id @default(uuid())

  reservationId String
  reservation   MaterialReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  productionOrderRequirementId String
  productionOrderRequirement   ProductionOrderRequirement @relation(fields: [productionOrderRequirementId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Null quando o item nao controla lote.
  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  quantity Decimal @db.Decimal(18, 6)

  /// Confirmacao fisica (Picking) desta linha — nunca cria
  /// InventoryMovement, nunca recalcula/reserva de novo. So pode ser
  /// confirmada uma vez; sem partial picking nesta fase (confirma a linha
  /// inteira).
  pickedAt DateTime?
  pickedBy String?

  /// Preenchidos quando esta linha e substituida no Picking (lote
  /// diferente do reservado, escolhido explicitamente pelo operador) —
  /// nunca apagada, so marcada como liberada. Reserved considera so linhas
  /// com releasedAt null.
  releasedAt    DateTime?
  releasedBy    String?
  releaseReason String?

  /// AMPLIACAO EXPLICITA DA RESERVA — preenchidos quando esta linha nao
  /// veio do RELEASE e sim de um "Adicionar consumo extra": o operador
  /// constatou que a producao precisa de mais material do que o reservado
  /// e pediu, com justificativa, que a reserva desta OP crescesse.
  ///
  /// A linha original nunca e tocada. Planejado, reservado originalmente,
  /// ampliacao e consumido real permanecem todos legiveis lado a lado.
  ///
  /// Nunca preenchidos automaticamente: estoque livre so vira reserva por
  /// ato explicito, nunca porque um consumo passou do limite.
  extraReason      String?
  extraRequestedBy String?
  extraRequestedAt DateTime?

  /// Self-relacao: a linha NOVA de uma substituicao aponta para a linha
  /// ORIGINAL que ela substitui — preserva a genealogia completa (nunca
  /// sobrescreve lotId apagando o lote originalmente reservado).
  replacesLineId String?                  @unique
  replacesLine   MaterialReservationLine? @relation("ReservationLineSubstitution", fields: [replacesLineId], references: [id])
  replacedByLine MaterialReservationLine? @relation("ReservationLineSubstitution")

  createdAt DateTime @default(now())

  consumptions    ProductionConsumption[]
  recipeWeighings RecipeWeighing[]

  @@index([itemId])
  @@index([lotId])
  @@index([reservationId])
  @@map("material_reservation_lines")
}

/// Evento REAL e imutavel de consumo de material — nunca editado/deletado.
/// Consumo pode ser parcial e acontecer varias vezes para a mesma
/// ReservationLine, ate o limite do que foi reservado (nunca overconsumption
/// nesta fase). Gera exatamente 1 InventoryMovement PRODUCTION_CONSUMPTION
/// (relacao 1:1 garantida — ver InventoryMovement.productionConsumptionId).
model ProductionConsumption {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])

  productionOrderRequirementId String
  productionOrderRequirement   ProductionOrderRequirement @relation(fields: [productionOrderRequirementId], references: [id])

  /// Exige Picking confirmado nesta linha antes do primeiro consumo.
  reservationLineId String
  reservationLine   MaterialReservationLine @relation(fields: [reservationLineId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Null quando o item nao controla lote.
  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  quantity Decimal @db.Decimal(18, 6)

  consumedAt DateTime
  consumedBy String?

  createdAt DateTime @default(now())

  inventoryMovement InventoryMovement?
  /// Pesagem da Folha de Receita que originou este consumo (quando veio de la).
  recipeWeighing    RecipeWeighing?

  @@index([productionOrderId])
  @@index([reservationLineId])
  @@index([itemId])
  @@map("production_consumptions")
}

/// Evento REAL e imutavel de producao parcial — nunca editado/deletado.
/// Uma OP pode ter varios (producao parcial e o comportamento normal).
/// producedQuantity da OP e sempre a soma destes, nunca uma segunda
/// coluna. Gera exatamente 1 InventoryMovement FINISHED_GOOD_PRODUCTION
/// (relacao 1:1 garantida — ver InventoryMovement.productionOutputId).
model ProductionOutput {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])

  /// Nulo so se o Finished Product Item nao controlar lote — bloqueado no
  /// service nesta fase (rastreabilidade do MVP pressupoe lote de produto
  /// acabado), mantido nullable no schema por simetria com os demais
  /// movimentos que tambem preveem item sem lote.
  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  quantity Decimal @db.Decimal(18, 6)

  producedAt DateTime
  producedBy String?
  notes      String?

  createdAt DateTime @default(now())

  inventoryMovement InventoryMovement?

  @@index([productionOrderId])
  @@index([lotId])
  @@map("production_outputs")
}

/// Demanda comercial do Cliente — nunca fonte de verdade de estoque/producao
/// por si so. DRAFT livremente editavel; CONFIRMED congela cliente/produtos/
/// quantidades via snapshot (mesmo padrao de Ordem de Compra) e habilita o
/// Plano de Atendimento; IN_FULFILLMENT ocorre quando o Plano e aplicado
/// (reserva de Produto Acabado + OPs DRAFT geradas). Sem exclusao fisica.
model CustomerOrder {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, PED-000001).
  /// Imutavel apos a criacao.
  code String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  orderDate             DateTime  @default(now())
  requestedDeliveryDate DateTime?

  status CustomerOrderStatus @default(DRAFT)
  notes  String?

  /// Snapshot historico — preenchido so ao confirmar. Enquanto DRAFT, o
  /// service le Customer ao vivo via join (mesmo padrao de OP/OC).
  customerCode       String?
  customerName       String?
  customerTradeName  String?
  customerCnpj       String?
  /// Endereco congelado no CONFIRM: editar o cadastro do Cliente depois
  /// nunca muda o que este documento diz. Pedidos confirmados antes da
  /// capacidade 33 permanecem com null.
  customerStreet     String?
  customerNumber     String?
  customerComplement String?
  customerDistrict   String?
  customerZipCode    String?
  customerCity       String?
  customerState      String?

  /// ORIGEM COMERCIAL — de qual proposta aceita este Pedido nasceu.
  ///
  /// Nulo em Pedido digitado direto (o caminho manual continua valido) e em
  /// todo Pedido anterior a esta capacidade. UNIQUE garante o invariante no
  /// banco: uma QuoteVersion aceita origina no maximo um Pedido. Postgres
  /// admite varios NULL num indice unico, entao Pedidos manuais nao colidem.
  ///
  /// SetNull, e nao Cascade: apagar a proposta nao pode apagar o Pedido. Os
  /// snapshots abaixo mantem a origem legivel mesmo se o vinculo se perder.
  sourceQuoteVersionId String?       @unique
  sourceQuoteVersion   QuoteVersion? @relation("CustomerOrderSourceQuote", fields: [sourceQuoteVersionId], references: [id], onDelete: SetNull)
  sourceProjectId      String?
  sourceProject        Project?      @relation("CustomerOrderSourceProject", fields: [sourceProjectId], references: [id], onDelete: SetNull)

  /// Identidade da origem, congelada: le-se sem depender do join.
  sourceQuoteCode          String?
  sourceQuoteVersionNumber Int?
  sourceProjectCode        String?

  /// O ACORDO, congelado no momento em que o Pedido nasceu.
  ///
  /// A QuoteVersion aceita ja e imutavel (so DRAFT edita), entao subtotal,
  /// desconto e total poderiam ser lidos dela. Ficam aqui porque o Pedido e
  /// um documento historico por si: ele responde "por que fechou por este
  /// valor" sem depender de nenhum outro registro continuar existindo.
  ///
  /// O desconto e GLOBAL sobre o subtotal e NAO e rateado nas linhas — o
  /// sistema nao possui essa regra, e inventar rateio criaria um preco por
  /// linha que ninguem acordou.
  agreedSubtotalAmount  Decimal? @db.Decimal(14, 2)
  agreedDiscountPercent Decimal? @db.Decimal(7, 4)
  agreedTotalAmount     Decimal? @db.Decimal(14, 2)

  /// Plano de pagamento como foi apresentado ao cliente (entrada, cada
  /// parcela com vencimento, juros, total a prazo).
  ///
  /// Congelado como resultado, e nao como parametros, de proposito: os
  /// parametros vivem na Quote e nao mudam, mas a ARITMETICA que os traduz
  /// em parcelas e codigo. Recalcular anos depois, com outra formula, daria
  /// um plano diferente do que o cliente assinou. Isto nao e financeiro nem
  /// contas a receber — e o registro do que foi acordado.
  agreedPaymentSchedule Json?

  confirmedAt DateTime?
  confirmedBy String?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines            CustomerOrderLine[]
  reservations     CustomerOrderReservation[]
  productionOrders ProductionOrder[]
  purchaseOrders   PurchaseOrder[]
  shipments        Shipment[]
  billings         Billing[]

  @@index([status])
  @@index([customerId])
  @@index([sourceProjectId])
  @@map("customer_orders")
}

/// Linha do Pedido — um Product por Pedido (garantido no banco). DRAFT:
/// substituida em bloco (delete+recreate) a cada save, mesmo padrao de
/// Ordem de Compra/Formulacao. CONFIRMED: congela via snapshot, imutavel.
model CustomerOrderLine {
  id String @id @default(uuid())

  customerOrderId String
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  orderedQuantity Decimal @db.Decimal(18, 6)
  unitCode        String

  /// Ordem de exibicao estavel.
  position Int

  /// Snapshot historico — preenchido so ao confirmar o Pedido.
  productCode      String?
  productName      String?
  finishedItemId   String?
  finishedItemCode String?
  finishedItemName String?

  /// ORIGEM COMERCIAL DA LINHA — qual linha da proposta virou esta.
  sourceQuoteLineId String?    @unique
  sourceQuoteLine   QuoteLine? @relation("CustomerOrderLineSourceQuoteLine", fields: [sourceQuoteLineId], references: [id], onDelete: SetNull)

  /// O PRECO ACORDADO e sua origem, congelados na criacao.
  ///
  /// O Pedido nunca recalcula preco, nunca busca a precificacao vigente e
  /// nunca reconstroi o acordo pelo CMV atual: PREC nova, CALC novo ou
  /// compra nova nao reescrevem o que o cliente aceitou.
  ///
  /// MANUAL permanece MANUAL — nao se procura uma PREC correspondente
  /// retroativamente, porque ela nao existiu na negociacao.
  agreedUnitPrice   Decimal?          @db.Decimal(14, 4)
  agreedPriceSource QuotePriceSource?

  /// Proveniencia da faixa, quando o preco veio de precificacao. Identidade
  /// apenas — custo, margem, markup e comissao continuam sendo informacao
  /// interna do orcamento e nao atravessam para o Pedido.
  agreedPricingVersionId     String?
  agreedPricingVersion       PricingVersion? @relation("CustomerOrderLinePricingVersion", fields: [agreedPricingVersionId], references: [id], onDelete: SetNull)
  agreedPricingTierId        String?
  agreedPricingTier          PricingTier?    @relation("CustomerOrderLinePricingTier", fields: [agreedPricingTierId], references: [id], onDelete: SetNull)
  agreedPricingCode          String?
  agreedPricingVersionNumber Int?
  agreedPricingTierQuantity  Decimal?        @db.Decimal(18, 6)
  agreedPricingTierUom       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservationLines CustomerOrderReservationLine[]
  productionOrders ProductionOrder[]
  shipmentLines    ShipmentLine[]
  billingLines     BillingLine[]

  @@unique([customerOrderId, productId])
  @@map("customer_order_lines")
}

/// Reserva de PRODUTO ACABADO por Pedido — contexto proprio, nunca reaproveita
/// MaterialReservation (materia-prima/embalagem de OP). Criada so ao aplicar
/// o Plano de Atendimento. Nunca cria InventoryMovement.
model CustomerOrderReservation {
  id String @id @default(uuid())

  customerOrderId String
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id])

  status CustomerOrderReservationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  createdBy String?

  releasedAt    DateTime?
  releasedBy    String?
  releaseReason String?

  lines CustomerOrderReservationLine[]

  @@index([customerOrderId])
  @@index([status])
  @@map("customer_order_reservations")
}

/// Alocacao oficial por item/lote de produto acabado de uma reserva de
/// Pedido — soma-se a `MaterialReservationLine` no calculo central de
/// Reserved em `inventory-ledger.ts` (nunca um segundo calculo paralelo).
/// Lote nulo so quando o Finished Product Item nao controla lote (mesmo
/// padrao de MaterialReservationLine).
model CustomerOrderReservationLine {
  id String @id @default(uuid())

  reservationId String
  reservation   CustomerOrderReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  customerOrderLineId String
  customerOrderLine   CustomerOrderLine @relation(fields: [customerOrderLineId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  quantity Decimal @db.Decimal(18, 6)

  /// Preenchidos quando o remanescente desta linha e realocado para outro
  /// lote (ex.: lote venceu antes da expedicao) — nunca apagada, so
  /// marcada. Reserved considera so linhas com releasedAt null; o que ja
  /// foi expedido continua referenciando esta linha historica.
  releasedAt    DateTime?
  releasedBy    String?
  releaseReason String?

  /// Self-relacao: a linha NOVA de uma realocacao aponta para a ORIGINAL
  /// que ela substitui. Diferente de MaterialReservationLine (substituicao
  /// 1:1 no Picking), aqui e 1:N — o remanescente pode ser dividido em
  /// varios lotes pelo allocation service.
  replacesLineId  String?
  replacesLine    CustomerOrderReservationLine?  @relation("CustomerReservationLineSubstitution", fields: [replacesLineId], references: [id])
  replacedByLines CustomerOrderReservationLine[] @relation("CustomerReservationLineSubstitution")

  createdAt DateTime @default(now())

  shipmentLines ShipmentLine[]

  @@index([itemId])
  @@index([lotId])
  @@map("customer_order_reservation_lines")
}

/// Expedicao (saida fisica de produto acabado de um Pedido). DRAFT e so
/// separacao — nunca altera estoque nem conta como expedido. CONFIRMED e a
/// realidade fisica: gera exatamente 1 InventoryMovement SHIPMENT_OUT por
/// linha e e historico imutavel (nunca cancelavel nesta fase). No maximo
/// uma DRAFT ativa por Pedido (garantido por indice parcial na migration).
model Shipment {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, EXP-000001).
  /// Imutavel apos a criacao.
  code String @unique

  customerOrderId String
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id])

  status ShipmentStatus @default(DRAFT)

  /// Preenchida na confirmacao — data da saida fisica real.
  shipmentDate DateTime?
  notes        String?

  confirmedAt DateTime?
  confirmedBy String?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    ShipmentLine[]
  billings Billing[]

  @@index([customerOrderId])
  @@index([status])
  @@map("shipments")
}

/// Linha de expedicao — sempre ligada a uma CustomerOrderReservationLine
/// especifica (so se expede o que esta reservado AO MESMO Pedido, nunca
/// estoque livre/reserva de outro Pedido/reserva de material de producao).
/// Snapshot preenchido na confirmacao, para leitura historica e base do
/// futuro Faturamento (que se baseia no realmente expedido).
model ShipmentLine {
  id String @id @default(uuid())

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  customerOrderLineId String
  customerOrderLine   CustomerOrderLine @relation(fields: [customerOrderLineId], references: [id])

  customerOrderReservationLineId String
  customerOrderReservationLine   CustomerOrderReservationLine @relation(fields: [customerOrderReservationLineId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Nullable por simetria com as demais linhas do sistema, mas o service
  /// exige lote real — Finished Product do MVP sempre controla lote.
  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  quantity Decimal @db.Decimal(18, 6)
  unitCode String

  /// Ordem de exibicao estavel.
  position Int

  /// Snapshot historico — preenchido so na confirmacao.
  productCode       String?
  productName       String?
  finishedItemCode  String?
  finishedItemName  String?
  lotCode           String?
  businessLotNumber String?

  /// Conferencia fisica do lote antes da saida. Auditoria minima: NAO e um
  /// ScanEvent generico, nao cria movimento e nao altera saldo — so registra
  /// que o lote reservado foi encontrado fisicamente. Uma linha loteada com
  /// quantidade > 0 so pode ser confirmada com `verifiedAt` preenchido.
  verifiedAt DateTime?
  verifiedBy String?

  createdAt DateTime @default(now())

  inventoryMovement InventoryMovement?
  billingLines      BillingLine[]

  @@index([shipmentId])
  @@index([customerOrderLineId])
  @@index([customerOrderReservationLineId])
  @@index([lotId])
  @@map("shipment_lines")
}

/// Documento de faturamento COMERCIAL de uma Expedicao confirmada. Reflete
/// SEMPRE o que foi realmente expedido (ShipmentLine de Shipment
/// CONFIRMED), nunca o pedido/reservado/planejado/produzido. No FAST MVP
/// cada Expedicao e faturada integralmente por um Billing — faturamento
/// parcial dentro da mesma Expedicao e evolucao futura explicita. No
/// maximo um Billing ativo (DRAFT/ISSUED) por Expedicao, garantido por
/// indice unico parcial na migration. Nunca gera InventoryMovement: a
/// saida fisica ja aconteceu no SHIPMENT_OUT da propria Expedicao.
model Billing {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, FAT-000001).
  /// Imutavel apos a criacao.
  code String @unique

  customerOrderId String
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id])

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  status BillingStatus @default(DRAFT)

  /// Referencia livre a documento externo/ERP/fiscal quando existir
  /// (ex.: "NF 12345") — o sistema nunca valida nem emite essa NF.
  externalReference String?
  notes             String?

  /// Snapshot historico do cliente/documentos de origem, congelado na
  /// criacao — reaproveita os snapshots ja existentes em CustomerOrder/
  /// Shipment, nunca um framework generico.
  customerCode      String?
  customerName      String?
  customerTradeName String?
  customerCnpj      String?
  customerOrderCode String?
  shipmentCode      String?
  shipmentDate      DateTime?

  issuedAt DateTime?
  issuedBy String?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines BillingLine[]

  @@index([customerOrderId])
  @@index([shipmentId])
  @@index([status])
  @@index([issuedAt])
  @@map("billings")
}

/// Linha de faturamento — copia fiel de uma ShipmentLine confirmada. A
/// quantidade NUNCA e recalculada a partir do Pedido nem editavel pelo
/// frontend; so `unitPrice` e editavel enquanto DRAFT. `lineTotal` nunca e
/// persistido — sempre derivado (`quantity x unitPrice`) com Decimal.
model BillingLine {
  id String @id @default(uuid())

  billingId String
  billing   Billing @relation(fields: [billingId], references: [id], onDelete: Cascade)

  shipmentLineId String
  shipmentLine   ShipmentLine @relation(fields: [shipmentLineId], references: [id])

  customerOrderLineId String
  customerOrderLine   CustomerOrderLine @relation(fields: [customerOrderLineId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  /// Snapshot historico — congelado na criacao do Billing.
  productCode       String
  productName       String
  itemCode          String
  itemName          String
  lotCode           String?
  businessLotNumber String?

  /// Identica a ShipmentLine.quantity — nunca recalculada, nunca editavel.
  quantity Decimal @db.Decimal(18, 6)
  unitCode String

  /// O PRECO ACORDADO no Pedido, congelado na criacao do Faturamento.
  ///
  /// Copia de CustomerOrderLine.agreedUnitPrice. Precificacao nova, CALC
  /// novo ou negociacao posterior nao o reescrevem — ele e a prova do que
  /// o cliente aceitou, nao uma consulta ao preco de hoje.
  ///
  /// Nulo apenas quando o Pedido de origem nao tinha preco acordado.
  agreedUnitPrice Decimal? @db.Decimal(14, 4)

  /// O PRECO EFETIVAMENTE FATURADO. Nasce igual a `agreedUnitPrice` e so
  /// difere apos um override explicito. Nunca inferido de PurchaseOrder
  /// (custo != preco de venda). BRL quando informado.
  unitPrice Decimal? @db.Decimal(14, 4)

  /// Override do preco faturado: acao separada, com permissao comercial,
  /// motivo obrigatorio e autoria. O acordado permanece intocado ao lado
  /// — a diferenca entre os dois e a evidencia.
  priceOverridden Boolean   @default(false)
  overrideReason  String?
  overriddenBy    String?
  overriddenAt    DateTime?

  /// Ordem de exibicao estavel.
  position Int

  createdAt DateTime @default(now())

  @@index([billingId])
  @@index([shipmentLineId])
  @@index([customerOrderLineId])
  @@map("billing_lines")
}

/// BIBLIOTECA TECNICA DE FORMULACOES.
///
/// Uma matriz reutilizavel entre clientes e produtos. O template NAO e a
/// formulacao de ninguem: usar um template COPIA os dados para uma
/// FormulationVersion propria do Produto, e a partir dai as duas vidas
/// seguem separadas.
///
/// A alternativa — varios produtos apontando para a mesma formulacao viva —
/// foi recusada de proposito: mexer na receita de um cliente reescreveria a
/// de outro, e ninguem descobriria antes da producao.
model FormulationTemplate {
  id String @id @default(uuid())

  /// FT-000001 — identidade da matriz na biblioteca.
  code String @unique

  name        String
  description String?

  /// Arquivar tira da biblioteca sem apagar historia: formulacoes criadas a
  /// partir dele continuam validas e continuam apontando para ele.
  archivedAt DateTime?
  archivedBy String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  versions FormulationTemplateVersion[]

  @@index([name])
  @@map("formulation_templates")
}

/// Uma versao da matriz. DRAFT edita, ACTIVE e historico.
///
/// Nao guarda item de saida — o template nao pertence a produto nenhum. Guarda
/// so a UNIDADE a que a base se refere, que e o suficiente para a copia fazer
/// sentido em qualquer produto medido naquela unidade.
model FormulationTemplateVersion {
  id String @id @default(uuid())

  formulationTemplateId String
  formulationTemplate   FormulationTemplate @relation(fields: [formulationTemplateId], references: [id], onDelete: Cascade)

  /// Sequencial por template (V1, V2...), gerado sob lock.
  versionNumber Int

  status FormulationTemplateVersionStatus @default(DRAFT)

  /// Mesmo significado da formulacao: estas quantidades produzem
  /// `basisQuantity` do produto acabado.
  basisQuantity   Decimal                    @db.Decimal(18, 6)
  calculationMode FormulationCalculationMode @default(FIXED_BASIS)
  dosesPerPackage Int?
  /// Unidade do produto acabado a que a base se refere ("un", "kg").
  outputUnitCode  String
  outputUnit      UnitOfMeasure              @relation("FormulationTemplateOutputUom", fields: [outputUnitCode], references: [code])

  notes String?

  createdAt DateTime @default(now())
  createdBy String?

  activatedAt DateTime?
  activatedBy String?

  archivedAt DateTime?
  archivedBy String?

  /// Versao que serviu de molde para esta, dentro do proprio template.
  sourceVersionId     String?
  sourceVersion       FormulationTemplateVersion?  @relation("FormulationTemplateVersionSource", fields: [sourceVersionId], references: [id])
  sourceVersionNumber Int?
  derivedVersions     FormulationTemplateVersion[] @relation("FormulationTemplateVersionSource")

  components FormulationTemplateComponent[]

  /// Formulacoes de Produto COPIADAS desta versao. Relacao de proveniencia:
  /// existe para responder "de onde veio esta receita", nunca para propagar
  /// mudanca de volta.
  derivedFormulationVersions FormulationVersion[]

  @@unique([formulationTemplateId, versionNumber])
  @@index([formulationTemplateId])
  @@index([status])
  @@map("formulation_template_versions")
}

/// Linha tecnica da matriz.
///
/// Espelha `FormulationComponent` no que e tecnico. Fica de fora o bloco
/// `legacy*`, que existe para conferir ERP contra planilha durante a
/// migracao — uma matriz de biblioteca nunca teve planilha para conferir.
model FormulationTemplateComponent {
  id String @id @default(uuid())

  formulationTemplateVersionId String
  formulationTemplateVersion   FormulationTemplateVersion @relation(fields: [formulationTemplateVersionId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  quantity Decimal @db.Decimal(18, 6)
  unitCode String

  basis FormulationComponentBasis @default(FIXED_BASIS)

  /// SUGESTAO, nao imposicao: quem fornece cada material muda de cliente
  /// para cliente. A copia leva este valor como ponto de partida e o
  /// usuario ajusta no produto sem tocar no template.
  supplyResponsibility SupplyResponsibility @default(VERIDI)

  purityPercentApplied Decimal? @db.Decimal(6, 3)
  overagePercent       Decimal? @db.Decimal(6, 3)

  notes String?

  /// Ordem de exibicao estavel.
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mesmo item nao aparece duas vezes na mesma versao.
  @@unique([formulationTemplateVersionId, itemId])
  @@map("formulation_template_components")
}

/// BIBLIOTECA TECNICA DE ESTRUTURAS DE CUSTO.
///
/// Responde "como normalmente produzimos este TIPO de produto": base de
/// producao, recursos usados e por quanto tempo, modo de energia, servicos e
/// rateios. Aplicar cria uma IndustrialCostVersion propria do Produto.
///
/// O que NAO vive aqui: tarifa, preco/hora, custo calculado. O template diz
/// "usar o misturador por 4 horas"; quanto vale essa hora e resolvido pelo
/// motor, na data de referencia, pela tarifa vigente. Congelar tarifa aqui
/// faria a biblioteca envelhecer sem ninguem perceber.
model IndustrialCostTemplate {
  id String @id @default(uuid())

  /// TEC-000001 — identidade da matriz industrial.
  code String @unique

  name        String
  description String?

  archivedAt DateTime?
  archivedBy String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  versions IndustrialCostTemplateVersion[]

  @@index([name])
  @@map("industrial_cost_templates")
}

model IndustrialCostTemplateVersion {
  id String @id @default(uuid())

  industrialCostTemplateId String
  industrialCostTemplate   IndustrialCostTemplate @relation(fields: [industrialCostTemplateId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        TemplateVersionStatus @default(DRAFT)

  /// Base de producao SUGERIDA. O produto pode adotar outra ao aplicar.
  referenceOutputQuantity Decimal       @db.Decimal(18, 6)
  referenceOutputUomCode  String
  referenceOutputUom      UnitOfMeasure @relation("CostTemplateOutputUom", fields: [referenceOutputUomCode], references: [code])

  /// Modo de energia como CONFIGURACAO. `FROM_EQUIPMENT` continua sendo
  /// "derive dos equipamentos" — nunca um resultado em kWh ou em reais.
  energyCalculationMode EnergyCalculationMode @default(NONE)
  energyResourceId      String?
  energyResource        IndustrialResource?   @relation("CostTemplateEnergyResource", fields: [energyResourceId], references: [id])

  notes String?

  createdAt DateTime @default(now())
  createdBy String?

  activatedAt DateTime?
  activatedBy String?
  archivedAt  DateTime?
  archivedBy  String?

  sourceVersionId     String?
  sourceVersion       IndustrialCostTemplateVersion?  @relation("CostTemplateVersionSource", fields: [sourceVersionId], references: [id])
  sourceVersionNumber Int?
  derivedVersions     IndustrialCostTemplateVersion[] @relation("CostTemplateVersionSource")

  resourceUsages  IndustrialCostTemplateResourceUsage[]
  additionalCosts IndustrialCostTemplateAdditionalCost[]

  /// Estruturas de custo COPIADAS desta versao — proveniencia, nunca canal.
  derivedCostVersions IndustrialCostVersion[]

  @@unique([industrialCostTemplateId, versionNumber])
  @@index([industrialCostTemplateId])
  @@index([status])
  @@map("industrial_cost_template_versions")
}

/// Recurso e QUANTO dele. Sem tarifa: os campos `rate*Snapshot` da estrutura
/// operacional existem para congelar economia na ativacao, e uma matriz de
/// biblioteca nao tem economia a congelar.
model IndustrialCostTemplateResourceUsage {
  id String @id @default(uuid())

  industrialCostTemplateVersionId String
  industrialCostTemplateVersion   IndustrialCostTemplateVersion @relation(fields: [industrialCostTemplateVersionId], references: [id], onDelete: Cascade)

  industrialResourceId String
  industrialResource   IndustrialResource @relation("CostTemplateResourceUsage", fields: [industrialResourceId], references: [id])

  usageBasis    IndustrialResourceUsageBasis @default(FIXED_PER_REFERENCE_BATCH)
  usageQuantity Decimal                      @db.Decimal(18, 6)
  usageUom      IndustrialRateUom

  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([industrialCostTemplateVersionId, industrialResourceId])
  @@index([industrialCostTemplateVersionId])
  @@map("industrial_cost_template_resource_usages")
}

/// Premissa adicional: embalagem secundaria, servico de terceiro, overhead.
///
/// `rateValue` aqui e o que a pessoa DIGITA como premissa da estrutura
/// ("R$ 180 por 1000 unidades"), nao uma tarifa resolvida de cadastro — por
/// isso viaja com o template.
model IndustrialCostTemplateAdditionalCost {
  id String @id @default(uuid())

  industrialCostTemplateVersionId String
  industrialCostTemplateVersion   IndustrialCostTemplateVersion @relation(fields: [industrialCostTemplateVersionId], references: [id], onDelete: Cascade)

  category    IndustrialCostCategory
  description String

  calculationBasis IndustrialCostBasis
  rateValue        Decimal?            @db.Decimal(14, 4)

  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([industrialCostTemplateVersionId])
  @@map("industrial_cost_template_additional_costs")
}

/// BIBLIOTECA COMERCIAL — POLITICA DE PRECIFICACAO.
///
/// Responde "como normalmente COMERCIALIZAMOS este tipo de produto": em que
/// faixas de quantidade, com que margem alvo e que comissao.
///
/// NAO e template de preco. Preco depende do custo do produto: copiar
/// "R$ 44,90" de um produto para outro levaria o custo alheio disfarcado de
/// decisao comercial. A politica guarda REGRA, e o preco nasce do motor sobre
/// o CALC daquele produto, no momento da aplicacao.
model PricingPolicyTemplate {
  id String @id @default(uuid())

  /// TPP-000001 — identidade da politica.
  code String @unique

  name        String
  description String?

  archivedAt DateTime?
  archivedBy String?

  createdAt DateTime @default(now())
  createdBy String?
  updatedAt DateTime @updatedAt

  versions PricingPolicyTemplateVersion[]

  @@index([name])
  @@map("pricing_policy_templates")
}

model PricingPolicyTemplateVersion {
  id String @id @default(uuid())

  pricingPolicyTemplateId String
  pricingPolicyTemplate   PricingPolicyTemplate @relation(fields: [pricingPolicyTemplateId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        TemplateVersionStatus @default(DRAFT)

  notes String?

  createdAt DateTime @default(now())
  createdBy String?

  activatedAt DateTime?
  activatedBy String?
  archivedAt  DateTime?
  archivedBy  String?

  sourceVersionId     String?
  sourceVersion       PricingPolicyTemplateVersion?  @relation("PricingPolicyVersionSource", fields: [sourceVersionId], references: [id])
  sourceVersionNumber Int?
  derivedVersions     PricingPolicyTemplateVersion[] @relation("PricingPolicyVersionSource")

  tiers PricingPolicyTemplateTier[]

  /// Precificacoes COPIADAS desta politica — proveniencia, nunca canal.
  derivedPricingVersions PricingVersion[]

  @@unique([pricingPolicyTemplateId, versionNumber])
  @@index([pricingPolicyTemplateId])
  @@index([status])
  @@map("pricing_policy_template_versions")
}

/// Uma faixa da politica: quantidade, margem alvo e comissao.
///
/// Sem `manualUnitPrice`: preco informado a mao e decisao de UMA negociacao,
/// sobre UM custo. Reutiliza-lo entre produtos seria transportar o acordo de
/// um cliente para outro sem que ninguem tivesse decidido isso.
///
/// Sem custo, preco sugerido, contribuicao ou markup: tudo isso e resultado, e
/// resultado nao e politica.
model PricingPolicyTemplateTier {
  id String @id @default(uuid())

  pricingPolicyTemplateVersionId String
  pricingPolicyTemplateVersion   PricingPolicyTemplateVersion @relation(fields: [pricingPolicyTemplateVersionId], references: [id], onDelete: Cascade)

  quantity Decimal       @db.Decimal(18, 6)
  uomCode  String
  uom      UnitOfMeasure @relation("PricingPolicyTierUom", fields: [uomCode], references: [code])

  /// So TARGET_MARGIN nesta fase — ver o comentario do modelo.
  priceMode PriceMode @default(TARGET_MARGIN)

  targetContributionMarginPercent Decimal? @db.Decimal(7, 4)
  commissionPercent               Decimal  @default(0) @db.Decimal(7, 4)

  notes     String?
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pricingPolicyTemplateVersionId, quantity])
  @@index([pricingPolicyTemplateVersionId])
  @@map("pricing_policy_template_tiers")
}
