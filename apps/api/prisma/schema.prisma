// Veridi Nutrition — schema Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ItemType {
  RAW_MATERIAL
  PACKAGING
  FINISHED_PRODUCT
}

enum UomDimension {
  MASS
  COUNT
  VOLUME
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseOrderOrigin {
  MANUAL
  CUSTOMER_ORDER
}

enum LotStatus {
  AWAITING_RELEASE
  AVAILABLE
  BLOCKED
  EXPIRED
}

/// Tipos do ledger de estoque. Preparado para expansao futura
/// (RETURN_TO_STOCK) — nao criado agora porque devolucao pos-producao
/// ainda nao existe.
enum InventoryMovementType {
  RECEIPT_IN
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  LOSS
  PRODUCTION_CONSUMPTION
  FINISHED_GOOD_PRODUCTION
  SHIPMENT_OUT
}

enum InventoryMovementSourceType {
  RECEIPT
  MANUAL_ADJUSTMENT
  STOCK_COUNT
  MANUAL_LOSS
  PRODUCTION_CONSUMPTION
  FINISHED_GOOD_PRODUCTION
  SHIPMENT
}

/// Lote recebido (RECEIPT, Supplier/Receipt/OC) ou lote produzido
/// (PRODUCTION, ProductionOutput/ProductionOrder/Product) — mesma
/// infraestrutura de Lot para as duas origens, nunca uma segunda tabela
/// paralela so para produto acabado.
enum LotOrigin {
  RECEIPT
  PRODUCTION
}

/// Como a versao calcula a necessidade de material.
/// FIXED_BASIS: "estas quantidades produzem `basisQuantity`" (modelo
/// original, preservado). PER_DOSE: a formula e declarada por DOSE do
/// produto acabado, do jeito que a industria realmente trabalha.
/// Quem DEVE fornecer o componente conforme a formulacao — intencao/regra,
/// nunca realidade fisica. A realidade fisica e o dono do Lot
/// (InventoryOwnerType).
enum SupplyResponsibility {
  VERIDI
  CUSTOMER
}

/// Dono do estoque fisico. Material do cliente fica dentro da Veridi mas
/// continua sendo do cliente — nunca some com o estoque proprio.
enum InventoryOwnerType {
  VERIDI
  CUSTOMER
}

/// Origem do Recebimento. CUSTOMER_SUPPLIED existe para NAO precisar de
/// Ordem de Compra falsa nem Fornecedor fake quando o material vem do
/// proprio cliente.
enum ReceiptSourceType {
  PURCHASE_ORDER
  CUSTOMER_SUPPLIED
}

enum FormulationCalculationMode {
  FIXED_BASIS
  PER_DOSE
}

/// Base de calculo do COMPONENTE. Uma mesma versao PER_DOSE tem
/// ingredientes por dose e embalagem por unidade acabada — cada linha
/// declara a propria base, sem engine de expressao.
enum FormulationComponentBasis {
  FIXED_BASIS
  PER_DOSE
  PER_FINISHED_UNIT
}

enum FormulationVersionStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

/// Lifecycle completo do roadmap — esta entrega so implementa
/// DRAFT->PLANNED e DRAFT/PLANNED->CANCELLED. RELEASED em diante chega
/// junto de Material Reservation.
enum ProductionOrderStatus {
  DRAFT
  PLANNED
  RELEASED
  IN_PRODUCTION
  COMPLETED
  BLOCKED
  CANCELLED
}

/// CUSTOMER_ORDER fica para o Bloco D (Pedidos & Atendimento) — nao criar
/// referencia fake agora.
enum ProductionOrderOrigin {
  MANUAL
  STOCK_PRODUCTION
  CUSTOMER_ORDER
}

/// DRAFT editavel; CONFIRMED congela cliente/produtos/quantidades (snapshot)
/// e habilita o Plano de Atendimento; IN_FULFILLMENT ocorre quando o Plano e
/// aplicado (reserva de PA + OPs DRAFT geradas). READY/PARTIALLY_SHIPPED/
/// SHIPPED ficam para expedicao futura, nao alcancaveis ainda.
enum CustomerOrderStatus {
  DRAFT
  CONFIRMED
  IN_FULFILLMENT
  PARTIALLY_SHIPPED
  SHIPPED
  CANCELLED
}

enum CustomerOrderReservationStatus {
  ACTIVE
  RELEASED
}

/// DRAFT e so separacao (nunca altera estoque); CONFIRMED e a saida fisica
/// real (gera SHIPMENT_OUT) e e historico imutavel — reversao exigiria
/// devolucao/reentrada explicita, nao implementada nesta fase.
enum ShipmentStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

/// Faturamento COMERCIAL/OPERACIONAL — nunca documento fiscal (NF-e/SEFAZ/
/// impostos estao fora do MVP). DRAFT permite so preco/observacoes/
/// referencia externa; ISSUED e historico imutavel (correcao pos-emissao
/// fica futura). Billing nunca movimenta estoque.
enum BillingStatus {
  DRAFT
  ISSUED
  CANCELLED
}

/// ACTIVE conta em Reserved; RELEASED (a reserva foi liberada — ex.:
/// cancelamento de OP RELEASED) nao conta mais. Nunca deletado — historico.
enum MaterialReservationStatus {
  ACTIVE
  RELEASED
}

/// Unidades de medida do sistema. Sem tela administrativa no MVP: seed
/// controlado pelo backend (prisma/seed.ts).
///
/// `toBaseFactor` e o fator de conversao para a unidade-base da dimensao
/// (MASS -> g, VOLUME -> L, COUNT -> un), fundacao para conversao entre
/// unidades compativeis quando formulacoes existirem. Conversao entre
/// dimensoes diferentes nunca e permitida.
model UnitOfMeasure {
  code         String       @id
  label        String
  dimension    UomDimension
  toBaseFactor Decimal      @db.Decimal(18, 6)

  items Item[]
  productsAsDoseUom Product[] @relation("ProductDoseUom")

  @@map("units_of_measure")
}

/// Item controlado pela operacao (materia-prima, embalagem ou produto acabado).
/// Cadastro base: sem estoque, fornecedor, preco ou lote fisico neste momento.
model Item {
  id   String   @id @default(uuid())
  type ItemType

  /// Codigo interno gerado pelo backend (sequence dedicada por tipo,
  /// MP-000001 / ME-000001 / PA-000001). Imutavel apos a criacao.
  code String @unique

  name            String
  unitCode        String
  unit            UnitOfMeasure @relation(fields: [unitCode], references: [code])
  controlsLot     Boolean       @default(true)
  controlsExpiry  Boolean       @default(true)

  /// Se um lote recebido deste item fica AWAITING_RELEASE (precisa
  /// liberacao da Qualidade) ou ja nasce AVAILABLE. Default por tipo
  /// (ITEM_TYPE_DEFAULTS em @veridi/shared), editavel pelo usuario — nao
  /// inferido permanentemente so pelo type.
  requiresQualityRelease Boolean @default(true)

  /// Codigo do sistema legado (planilhas) — reconciliacao da importacao,
  /// nunca identidade operacional.
  externalCode String?

  /// Fonte / forma quimica realmente utilizada (ex.: "Cloridrato de
  /// tiamina" para o item "Vitamina B1"). Texto livre nesta fase — nao
  /// existe entidade Source.
  sourceName String?

  /// Denominacao nutricional declarada (ex.: "Vitamina B1", "Magnesio").
  /// Diferente de `name` quando necessario; embalagem normalmente fica null.
  declaredNutrient String?

  family ItemFamily?

  /// Pureza padrao conhecida da materia-prima, em porcentagem (0 < x <= 100).
  /// `null` significa DESCONHECIDA — nunca deve ser lida como 100%. E apenas
  /// o default para novas formulacoes: a capacidade 34 congelara
  /// `purityPercentApplied` no componente, entao mudar este campo nunca
  /// altera formulacao/OP historica.
  defaultPurityPercent Decimal? @db.Decimal(6, 3)

  /// So para type = PACKAGING; permanece null nos demais tipos.
  packagingSubtype PackagingSubtype?

  externalBarcode String?
  active          Boolean       @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Produto que usa este item (type = FINISHED_PRODUCT) como saida
  /// fisica. 1:1 no MVP — ver Product.finishedProductItemId.
  product Product?

  purchaseOrderLines PurchaseOrderLine[]
  receiptLines        ReceiptLine[]
  lots                Lot[]
  inventoryMovements  InventoryMovement[]
  formulationComponents FormulationComponent[]
  formulationVersionsAsOutput FormulationVersion[]
  productionOrderRequirements ProductionOrderRequirement[]
  productionOrdersAsFinishedItem ProductionOrder[] @relation("ProductionOrderFinishedItem")
  materialReservationLines MaterialReservationLine[]
  productionConsumptions ProductionConsumption[]
  customerOrderReservationLines CustomerOrderReservationLine[]
  shipmentLines ShipmentLine[]
  billingLines BillingLine[]

  @@index([type])
  @@index([active])
  @@index([externalBarcode])
  @@index([family])
  @@index([externalCode])
  @@map("items")
}

/// Fornecedor. Cadastro base: sem preco, avaliacao, dados bancarios ou
/// vinculo com Item neste momento (entra em Compras/Recebimento).
model Supplier {
  id   String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, FOR-000001).
  /// Imutavel apos a criacao.
  code String @unique

  legalName String
  tradeName String?

  /// Somente digitos. Unicidade (quando informado) garantida por indice
  /// parcial na migration — Prisma nao modela unique index parcial.
  cnpj  String?
  email String?
  phone String?
  notes String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  receipts       Receipt[]
  lots           Lot[]

  @@index([active])
  @@map("suppliers")
}

/// Familia industrial do Item — classificacao operacional usada pelo
/// cadastro e pelas futuras capacidades de formulacao/custeio. Lista fixa
/// nesta fase: nao existe cadastro configuravel de familias.
enum ItemFamily {
  VITAMIN
  MINERAL
  AMINO_ACID
  EXCIPIENT
  BOTANICAL
  OTHER_RAW_MATERIAL
  PACKAGING
  OTHER
}

/// Subtipo de embalagem. So faz sentido para Item.type = PACKAGING —
/// coerencia validada no service.
enum PackagingSubtype {
  POT
  CAP
  SCOOP
  SEAL
  LABEL
  BOX
  POUCH
  CARTON
  BOTTLE
  OTHER
}

/// Forma farmaceutica do Product.
enum DosageForm {
  CAPSULE
  POWDER
  TABLET
  LIQUID
  OTHER
}

/// Apresentacao comercial do Product — NAO confundir com o Item de
/// embalagem usado na formulacao.
enum PresentationType {
  POT
  POUCH
  CARTON
  BULK
  BOTTLE
  OTHER
}

/// Publico-alvo declarado. Nesta fase e apenas cadastro descritivo:
/// nenhuma regra regulatoria (IDR/%VD/ANVISA) depende dele — isso e o
/// gate do Bloco H.
enum TargetAgeGroup {
  ADULT
  CHILD
  PREGNANT
  LACTATING
  OTHER
}

/// Cliente. Cadastro base: sem CRM, tabela de preco ou pedido neste momento.
model Customer {
  id   String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, CLI-000001).
  /// Imutavel apos a criacao.
  code String @unique

  legalName String
  tradeName String?

  /// Somente digitos. Unicidade (quando informado) garantida por indice
  /// parcial na migration — Prisma nao modela unique index parcial.
  cnpj  String?
  email String?
  phone String?

  /// Codigo do sistema legado (planilhas). Serve para importacao e
  /// reconciliacao — NUNCA substitui `code`, que continua sendo a
  /// identidade operacional do ERP.
  externalCode String?

  /// Endereco estruturado. Todos opcionais: clientes cadastrados antes da
  /// capacidade 33 continuam validos com os campos em null.
  street     String?
  number     String?
  complement String?
  district   String?
  /// Somente digitos quando informado (a formatacao 00000-000 e da UI).
  zipCode    String?
  city       String?

  /// UF brasileira, sempre maiuscula.
  state String?
  notes String?

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  customerOrders CustomerOrder[]
  ownedLots Lot[]
  receipts Receipt[]
  productionOrders ProductionOrder[]

  @@index([active])
  @@index([externalCode])
  @@map("customers")
}

/// Definicao comercial/industrial do produto fabricado pela Veridi.
/// Distinto de Item: Item e a entidade fisica controlada em estoque
/// (inclusive o Item FINISHED_PRODUCT correspondente); Product e a
/// definicao comercial a que pertencerao formulacoes e OPs no futuro.
/// Cadastro base: sem formulacao, OP, preco ou multiplos SKUs neste momento.
model Product {
  id   String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, PROD-000001).
  /// Imutavel apos a criacao.
  code String @unique

  name String

  /// Cliente opcional. Associacao historica preservada mesmo se o
  /// Customer for inativado depois — regra de negocio validada no service,
  /// nao no schema.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  /// Item FINISHED_PRODUCT opcional, 1:1 (unique mesmo sendo nullable —
  /// Postgres permite multiplos NULL em indice unique, sem precisar de
  /// indice parcial). type/active validados no service na criacao do
  /// vinculo; associacao historica preservada se o Item for inativado depois.
  finishedProductItemId String? @unique
  finishedProductItem   Item?   @relation(fields: [finishedProductItemId], references: [id])

  /// Perfil industrial (capacidade 33). Todos opcionais: produtos
  /// cadastrados antes continuam validos. Nenhum deles altera calculo de
  /// estoque/producao — sao cadastro, insumo para as capacidades 34-47.
  dosageForm       DosageForm?
  presentationType PresentationType?

  /// Quantidade de capsulas por dose (normalmente com dosageForm CAPSULE).
  capsulesPerDose Int?

  /// Dose declarada (ex.: 500 mg). `doseUom` existe porque a unidade da
  /// dose pode ser diferente da unidade de estoque do Finished Item.
  doseAmount Decimal?       @db.Decimal(18, 6)
  doseUomCode String?
  doseUom     UnitOfMeasure? @relation("ProductDoseUom", fields: [doseUomCode], references: [code])

  dosesPerPackage      Int?
  unitsPerShippingBox  Int?

  /// Publico-alvo — descritivo nesta fase, sem regra regulatoria.
  targetAgeGroup TargetAgeGroup?

  /// Vida util padrao em meses. A capacidade 36 podera sugerir
  /// `validade = data de producao + shelfLifeMonths`; aqui e so cadastro.
  shelfLifeMonths Int?

  /// Lote minimo de fabricacao, na unidade do Finished Product Item —
  /// por isso nao existe `minimumBatchUom`. Nao bloqueia OP nesta fase.
  minimumBatchQuantity Decimal? @db.Decimal(18, 6)

  externalCode String?
  notes        String?
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formulationVersions FormulationVersion[]
  productionOrders    ProductionOrder[]
  customerOrderLines  CustomerOrderLine[]
  customerOrderReservationLines CustomerOrderReservationLine[]
  shipmentLines       ShipmentLine[]
  billingLines        BillingLine[]

  @@index([active])
  @@index([customerId])
  @@map("products")
}

/// Versao de formulacao — pertence ao Product, nao ao Item de saida
/// diretamente. DRAFT e editavel; ACTIVE/INACTIVE sao imutaveis por
/// construcao (nenhuma rota de edicao aceita nesses status). No maximo uma
/// ACTIVE por Product (garantido tambem por indice unico parcial na
/// migration). Mudar a formulacao sempre cria uma nova versao — nunca
/// edita uma ACTIVE.
model FormulationVersion {
  id String @id @default(uuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Sequencial por Product (V1, V2...) — NAO e uma sequence global.
  versionNumber Int

  status FormulationVersionStatus @default(DRAFT)

  /// "Estas quantidades de componentes produzem `basisQuantity` do produto
  /// acabado" — base de calculo, futura fundacao do Requirement Calculation
  /// da OP (nao implementado ainda).
  basisQuantity Decimal @db.Decimal(18, 6)

  /// Modo de calculo da versao. FIXED_BASIS preserva o comportamento
  /// original; PER_DOSE declara a formula por DOSE do produto acabado, do
  /// jeito que a industria trabalha.
  calculationMode FormulationCalculationMode @default(FIXED_BASIS)

  /// Doses por embalagem — obrigatorio no modo PER_DOSE, nulo no
  /// FIXED_BASIS. E o elo entre "mg por dose" e a unidade vendida.
  dosesPerPackage Int?

  /// Snapshot do output no momento da criacao/copia da versao — nunca
  /// depende da associacao ATUAL do Product (que pode mudar depois),
  /// preservando o significado historico da versao.
  outputItemId   String
  outputItem     Item   @relation(fields: [outputItemId], references: [id])
  outputItemCode String
  outputItemName String
  outputUnitCode String

  notes String?

  createdAt DateTime @default(now())
  createdBy String?

  activatedAt DateTime?
  activatedBy String?

  inactivatedAt DateTime?
  inactivatedBy String?

  components FormulationComponent[]
  productionOrders ProductionOrder[]

  /// V1/V2/... e sempre unico dentro do mesmo Product.
  @@unique([productId, versionNumber])
  @@index([productId])
  @@index([status])
  @@map("formulation_versions")
}

/// Linha de componente (materia-prima/embalagem) de uma versao de
/// formulacao. So existe/muda enquanto a versao e DRAFT.
model FormulationComponent {
  id String @id @default(uuid())

  formulationVersionId String
  formulationVersion   FormulationVersion @relation(fields: [formulationVersionId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Significado depende de `basis`: quantidade para a base da versao
  /// (FIXED_BASIS), por dose (PER_DOSE) ou por unidade acabada
  /// (PER_FINISHED_UNIT — embalagem).
  quantity Decimal @db.Decimal(18, 6)

  /// Pode diferir da unidade de estoque do Item, desde que mesma dimensao
  /// (ex.: item em kg, componente em g) — validado via lib/uom existente.
  unitCode String

  basis FormulationComponentBasis @default(FIXED_BASIS)

  /// Responsabilidade de fornecimento — congelada na versao junto com o
  /// resto. Mudar depois nunca reescreve uma versao ACTIVE historica.
  supplyResponsibility SupplyResponsibility @default(VERIDI)

  /// SNAPSHOT da pureza aplicada nesta formulacao (0 < x <= 100). Copiada
  /// de Item.defaultPurityPercent quando existir no momento da criacao —
  /// alterar o Item depois NUNCA muda esta versao. `null` = pureza
  /// desconhecida: nenhuma correcao e aplicada (jamais assume 100% para
  /// "consertar" o numero).
  purityPercentApplied Decimal? @db.Decimal(6, 3)

  /// Perda/excesso de processo em % (>= 0). `null` = nao informado; nunca
  /// e inferido matematicamente so para bater com um total historico.
  overagePercent Decimal? @db.Decimal(6, 3)

  /// Referencia historica da planilha (total que a fabrica pesava e o
  /// tamanho do lote correspondente). NUNCA entra no calculo — existe para
  /// comparar ERP x historico durante a migracao.
  legacyTotalQuantity Decimal? @db.Decimal(18, 6)
  legacyTotalUnitCode String?
  legacyBatchUnits    Decimal? @db.Decimal(18, 6)

  notes String?

  /// Ordem de exibicao estavel — nao depende da ordem de insercao no banco.
  position Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mesmo Item nao pode aparecer duas vezes na mesma versao.
  @@unique([formulationVersionId, itemId])
  @@map("formulation_components")
}

/// Ordem de Compra — primeira feature transacional. DRAFT e livremente
/// editavel; ao confirmar (ORDERED) o conteudo (fornecedor/itens/
/// quantidades/precos) fica congelado — so previsao de entrega e
/// observacoes continuam editaveis. Sem exclusao fisica; cancelar preserva
/// o documento no historico.
model PurchaseOrder {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, OC-000001).
  /// Imutavel apos a criacao.
  code String @unique

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id])

  /// Snapshot do fornecedor no momento do pedido. Acompanha edicoes
  /// enquanto DRAFT (revalidado a cada save); congela ao confirmar.
  /// Fonte de verdade para exibir o documento, independente de mudancas
  /// futuras no cadastro de Supplier.
  supplierCode String
  supplierName String
  supplierCnpj String?

  orderDate            DateTime
  expectedDeliveryDate DateTime?

  status PurchaseOrderStatus @default(DRAFT)
  notes  String?

  origin PurchaseOrderOrigin @default(MANUAL)

  /// Preenchido so quando origin = CUSTOMER_ORDER — a OC nasce DRAFT e
  /// segue o fluxo normal (nunca ORDERED automatico). Vinculo permite
  /// navegar Pedido -> OC e OC -> Pedido.
  customerOrderId String?
  customerOrder   CustomerOrder? @relation(fields: [customerOrderId], references: [id])

  orderedAt DateTime?
  orderedBy String?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  lines    PurchaseOrderLine[]
  receipts Receipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([supplierId])
  @@index([customerOrderId])
  @@map("purchase_orders")
}

/// Linha de Ordem de Compra. So existem/mudam enquanto a OC e DRAFT —
/// congeladas junto com o documento ao confirmar.
model PurchaseOrderLine {
  id String @id @default(uuid())

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Snapshot do item no momento da linha — mesma logica do supplier acima.
  itemCode String
  itemName String
  unitCode String

  orderedQuantity Decimal  @db.Decimal(18, 6)

  /// PRECO PREVISTO/NEGOCIADO — nunca custo real nem valor pago. Serve
  /// como referencia visual no Recebimento, mas o custo so vira real
  /// quando informado explicitamente em ReceiptLine.actualUnitCost.
  /// Nunca alimenta as medias de custo real.
  unitPrice       Decimal? @db.Decimal(14, 4)

  receiptLines ReceiptLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Mesmo Item nao pode aparecer duas vezes na mesma OC (MVP).
  @@unique([purchaseOrderId, itemId])
  @@map("purchase_order_lines")
}

/// Evento de recebimento CONFIRMADO de uma Ordem de Compra. Sem DRAFT
/// persistido — o frontend monta tudo e confirma de uma vez. Historico/
/// somente-leitura depois de criado; nunca excluido.
///
/// Nao duplica snapshot de fornecedor: reaproveita o snapshot ja congelado
/// em PurchaseOrder (supplierCode/supplierName/supplierCnpj), suficiente
/// e imutavel. supplierId fica aqui so para filtro direto.
model Receipt {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, REC-000001).
  code String @unique

  sourceType ReceiptSourceType @default(PURCHASE_ORDER)

  /// Preenchidos so quando sourceType=PURCHASE_ORDER — recebimento de
  /// material do cliente nao inventa OC nem fornecedor.
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  /// Obrigatorio quando sourceType=CUSTOMER_SUPPLIED — dono do material
  /// recebido (CHECK no banco).
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  receivedAt        DateTime
  invoiceNumber     String?
  documentReference String?
  notes             String?

  lines ReceiptLine[]

  createdAt DateTime @default(now())
  createdBy String?

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([customerId])
  @@map("receipts")
}

/// Linha de recebimento — quanto de uma PurchaseOrderLine chegou fisicamente
/// neste Receipt. Item code/nome ja estao congelados na PurchaseOrderLine
/// vinculada; nao duplica aqui.
model ReceiptLine {
  id String @id @default(uuid())

  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  /// Null em recebimento de material do cliente — a linha e direta, sem
  /// OC. Para linhas de OC continua obrigatorio na pratica.
  purchaseOrderLineId String?
  purchaseOrderLine    PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Snapshot do item na linha. Linhas antigas de OC ficaram com null e
  /// continuam lendo o snapshot da PurchaseOrderLine — nunca reescritas.
  itemCode String?
  itemName String?

  receivedQuantity Decimal @db.Decimal(18, 6)
  unitCode         String

  /// Identificacao do fornecedor para o lote — nunca substituida pelo
  /// nosso codigo interno. Obrigatoria quando Item.controlsLot=true.
  supplierLot String?

  /// Obrigatoria quando Item.controlsExpiry=true; nunca anterior a receivedAt.
  expiryDate DateTime?

  /// Local fisico simples (string livre) — sem Warehouse/Zone/Bin ainda.
  location String?

  /// Preenchido apos a criacao do Lot (mesma transacao) quando
  /// Item.controlsLot=true. Null quando o item nao controla lote.
  lotId String? @unique
  lot   Lot?    @relation(fields: [lotId], references: [id])

  /// CUSTO EFETIVO DE AQUISICAO por unidade de estoque do Item. Nunca
  /// copiado automaticamente de PurchaseOrderLine.unitPrice (que e so
  /// preco previsto/negociado) e nunca confundido com valor pago (camada
  /// financeira futura). `null` = desconhecido; `0` e um valor
  /// explicitamente informado, nunca reinterpretado como desconhecido.
  /// Nomeado "de aquisicao" para no futuro comportar mercadoria + frete +
  /// despesas diretamente atribuiveis, sem quebrar o schema.
  actualUnitCost Decimal? @db.Decimal(14, 4)
  costUpdatedAt  DateTime?
  costUpdatedBy  String?
  costNote       String?

  createdAt DateTime @default(now())

  /// 1:1 com o InventoryMovement RECEIPT_IN gerado ao confirmar o
  /// recebimento — ver InventoryMovement.receiptLineId.
  inventoryMovement InventoryMovement?

  @@index([purchaseOrderLineId])
  @@index([itemId])
  @@map("receipt_lines")
}

/// Lote interno — criado automaticamente quando Item.controlsLot=true, seja
/// por Recebimento (origin=RECEIPT) ou por Producao (origin=PRODUCTION).
/// Mesma infraestrutura para as duas origens — nunca um segundo modelo de
/// lote so para produto acabado. `initialReceivedQuantity` e so o quanto
/// entrou no evento que criou o lote (recebimento OU primeira producao):
/// NAO e saldo atual. Saldo fisico vem do ledger de Inventory Movements.
model Lot {
  id String @id @default(uuid())

  /// LT-YYYYMMDD-NNNNNN — data do evento (recebimento ou producao) +
  /// sequence global (nao reinicia por dia). Gerado pelo backend,
  /// imutavel, unico. Mesmo identificador usado no QR interno para as
  /// duas origens.
  code String @unique

  origin LotOrigin @default(RECEIPT)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Obrigatorio para origin=RECEIPT; sempre null para origin=PRODUCTION —
  /// nunca fornecedor fake so para preencher a coluna.
  supplierId String?
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  /// DONO do estoque fisico — independente de Supplier (quem vendeu) e de
  /// quem enviou. VERIDI exige ownerCustomerId null; CUSTOMER exige
  /// ownerCustomerId preenchido (CHECK no banco). Imutavel apos a criacao:
  /// nao existe troca de propriedade nesta fase.
  ownerType       InventoryOwnerType @default(VERIDI)
  ownerCustomerId String?
  ownerCustomer   Customer?          @relation(fields: [ownerCustomerId], references: [id])

  receiptLine ReceiptLine?

  /// Preenchido so para origin=PRODUCTION — a OP que produziu este lote.
  /// Nunca junto com supplierId.
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  /// Lote comercial/Veridi — informado pelo usuario ao criar um lote de
  /// producao, permanece historico (nunca sobrescrito). Nunca substitui
  /// `code` (identidade interna) nem `supplierLot` (identificacao do
  /// fornecedor). Sem algoritmo automatico ainda — decisao futura.
  businessLotNumber String?

  /// So para origin=RECEIPT — identificacao do fornecedor, nunca
  /// preenchida para lote produzido.
  supplierLot String?
  expiryDate  DateTime?

  initialReceivedQuantity Decimal @db.Decimal(18, 6)

  status   LotStatus @default(AVAILABLE)
  location String?

  releasedAt DateTime?
  releasedBy String?

  blockedAt   DateTime?
  blockedBy   String?
  blockReason String?

  createdAt DateTime @default(now())
  createdBy String?

  inventoryMovements InventoryMovement[]
  materialReservationLines MaterialReservationLine[]
  productionConsumptions ProductionConsumption[]
  productionOutputs ProductionOutput[]
  customerOrderReservationLines CustomerOrderReservationLine[]
  shipmentLines ShipmentLine[]
  billingLines BillingLine[]

  @@index([itemId])
  @@index([supplierId])
  @@index([status])
  @@index([productionOrderId])
  @@index([ownerCustomerId])
  @@map("lots")
}

/// Ledger de movimentacoes fisicas de estoque — fonte de verdade das
/// quantidades (On Hand = soma algebrica por item/lote). Historico
/// imutavel: nunca editado/excluido; erro operacional se corrige com novo
/// movimento compensatorio. Lot.initialReceivedQuantity NAO e saldo — o
/// saldo sempre vem daqui.
model InventoryMovement {
  id String @id @default(uuid())

  /// onDelete Cascade so importa para limpeza de fixture de teste — em
  /// producao Item/Lot/ReceiptLine nunca sao excluidos fisicamente.
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  /// Null quando o item nao controla lote (Item.controlsLot = false).
  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id], onDelete: Cascade)

  type InventoryMovementType

  /// Sempre positivo (magnitude) — o sinal na soma do On Hand vem do
  /// `type` (RECEIPT_IN/ADJUSTMENT_IN = +, ADJUSTMENT_OUT/LOSS = -), nunca
  /// de um valor negativo armazenado.
  quantity Decimal @db.Decimal(18, 6)

  occurredAt DateTime

  sourceType InventoryMovementSourceType
  sourceId   String?

  /// Preenchido so para RECEIPT_IN — FK real 1:1 com ReceiptLine, garante
  /// no banco que um ReceiptLine confirmado gera no maximo um RECEIPT_IN.
  receiptLineId String?      @unique
  receiptLine   ReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)

  /// Preenchido so para PRODUCTION_CONSUMPTION — FK real 1:1, garante no
  /// banco que um ProductionConsumption gera no maximo um movimento.
  productionConsumptionId String?                @unique
  productionConsumption   ProductionConsumption? @relation(fields: [productionConsumptionId], references: [id], onDelete: Cascade)

  /// Preenchido so para FINISHED_GOOD_PRODUCTION — FK real 1:1, garante no
  /// banco que um ProductionOutput gera no maximo um movimento.
  productionOutputId String?            @unique
  productionOutput   ProductionOutput? @relation(fields: [productionOutputId], references: [id], onDelete: Cascade)

  /// Preenchido so para SHIPMENT_OUT — FK real 1:1, garante no banco que
  /// uma ShipmentLine confirmada gera no maximo um movimento de saida.
  shipmentLineId String?       @unique
  shipmentLine   ShipmentLine? @relation(fields: [shipmentLineId], references: [id], onDelete: Cascade)

  /// Obrigatorio (validado no service) para ajuste/perda; sempre null em RECEIPT_IN.
  reason String?

  createdBy String?
  createdAt DateTime @default(now())

  @@index([itemId])
  @@index([lotId])
  @@index([type])
  @@index([occurredAt])
  @@map("inventory_movements")
}

/// Ordem de Producao. DRAFT e livremente editavel (Product/Formulacao/
/// quantidade/notas), regenerando Requirements a cada mudanca relevante.
/// PLANNED congela Product/versao de formulacao/quantidade/Requirements —
/// so notas continuam editaveis. Sem exclusao fisica; cancelar preserva o
/// documento e os Requirements no historico.
model ProductionOrder {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, OP-000001).
  /// Imutavel apos a criacao.
  code String @unique

  productId String
  product   Product @relation(fields: [productId], references: [id])

  /// Null enquanto DRAFT sem formulacao definida (produto sem ACTIVE, ou
  /// ainda nao escolhida). Pode referenciar qualquer versao do Product
  /// durante DRAFT (para prever Requirements); PLAN exige que a versao
  /// esteja ACTIVE no momento.
  formulationVersionId String?
  formulationVersion   FormulationVersion? @relation(fields: [formulationVersionId], references: [id])

  plannedQuantity Decimal @db.Decimal(18, 6)
  outputUnitCode  String

  status ProductionOrderStatus @default(DRAFT)
  origin ProductionOrderOrigin @default(MANUAL)

  /// Preenchidos so quando origin = CUSTOMER_ORDER — a OP nasce DRAFT e
  /// segue o fluxo normal (PLAN/RELEASE manuais), nunca pula etapa por
  /// causa da origem. customerOrderLineId identifica a linha especifica
  /// atendida (uma OP por linha nesta fase).
  customerOrderId String?
  customerOrder   CustomerOrder? @relation(fields: [customerOrderId], references: [id])

  customerOrderLineId String?
  customerOrderLine   CustomerOrderLine? @relation(fields: [customerOrderLineId], references: [id])

  notes String?

  /// Snapshot historico — preenchido so ao planejar (PLANNED). Enquanto
  /// DRAFT, o service le Product/FormulationVersion/Item ao vivo via join.
  productCode  String?
  productName  String?

  finishedItemId   String?
  finishedItem     Item?   @relation("ProductionOrderFinishedItem", fields: [finishedItemId], references: [id])
  finishedItemCode String?
  finishedItemName String?

  formulationVersionNumber Int?

  /// Cliente da OP — resolvido do CustomerOrder (origin=CUSTOMER_ORDER) ou
  /// do Product. Necessario para usar material de propriedade do cliente.
  /// Nunca reescrito quando Product.customerId mudar depois.
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  customerCode String?
  customerName String?
  customerCnpj String?

  plannedAt DateTime?
  plannedBy String?

  /// Preenchido em PLANNED -> RELEASED. Reservation e a alocacao oficial
  /// criada nesse momento — ver MaterialReservation.
  releasedAt DateTime?
  releasedBy String?

  /// Preenchido no PRIMEIRO consumo real confirmado (RELEASED ->
  /// IN_PRODUCTION). Nao existe botao "Iniciar producao" separado — o
  /// primeiro Consumo confirmado e o que caracteriza o inicio.
  startedAt DateTime?
  startedBy String?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  /// Preenchidos em IN_PRODUCTION -> COMPLETED. completionReason e
  /// obrigatorio so quando producedQuantity < plannedQuantity (variancia).
  completedAt      DateTime?
  completedBy      String?
  completionReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requirements ProductionOrderRequirement[]

  /// No maximo uma reserva operacional por OP, criada no RELEASE. Nunca
  /// recriada mesmo se a OP RELEASED for cancelada (fica historica).
  reservation MaterialReservation?

  consumptions ProductionConsumption[]

  /// Eventos reais de producao parcial — producedQuantity e sempre a soma
  /// destes, nunca uma segunda coluna manual.
  outputs ProductionOutput[]

  /// Lotes de produto acabado gerados por esta OP (origin=PRODUCTION).
  finishedLots Lot[]

  @@index([status])
  @@index([productId])
  @@index([customerOrderId])
  @@index([customerId])
  @@map("production_orders")
}

/// Necessidade de material CONGELADA da OP — nunca guarda On Hand/
/// Reserved/Available/On Order/Shortage (isso e sempre calculado ao vivo
/// na leitura, a partir do Inventory Ledger). Regenerada (delete+recreate)
/// a cada mudanca relevante enquanto a OP e DRAFT; congelada ao planejar.
model ProductionOrderRequirement {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Snapshot — mesmo padrao de linha de documento historico.
  itemCode String
  itemName String
  itemType ItemType

  /// Quantidade/unidade originais da formula (component.quantity/unitCode).
  formulaQuantity Decimal @db.Decimal(18, 6)
  formulaUnitCode String

  /// SNAPSHOT da responsabilidade de fornecimento vinda do
  /// FormulationComponent. A OP nunca volta a consultar a formulacao atual
  /// para decidir de quem o material deveria vir.
  supplyResponsibility SupplyResponsibility @default(VERIDI)

  /// Necessidade TEORICA (antes de pureza/overage), na unidade de estoque.
  theoreticalQuantity Decimal? @db.Decimal(18, 6)

  /// Pureza/overage efetivamente aplicados — congelados junto com a OP.
  purityPercentApplied Decimal? @db.Decimal(6, 3)
  overagePercent       Decimal? @db.Decimal(6, 3)

  /// Necessidade FISICA final (ja com pureza/overage), convertida para a
  /// unidade de estoque do Item — fonte de verdade da necessidade da OP.
  requiredQuantity Decimal @db.Decimal(18, 6)
  stockUnitCode    String

  /// Ordem de exibicao estavel.
  position Int

  createdAt DateTime @default(now())

  reservationLines MaterialReservationLine[]
  consumptions ProductionConsumption[]

  @@unique([productionOrderId, itemId])
  @@map("production_order_requirements")
}

/// Reserva de materiais criada no RELEASE da OP — a partir daqui Reserved
/// deixa de ser 0 fixo e passa a ser a soma real das linhas ACTIVE. Nunca
/// altera On Hand, nunca cria InventoryMovement. Nunca deletada — historico
/// (ACTIVE conta em Reserved; RELEASED nao conta mais).
model MaterialReservation {
  id String @id @default(uuid())

  /// No maximo uma por OP (garantido no banco) — reserva nasce so pela
  /// regra de dominio do RELEASE, nunca por endpoint generico.
  productionOrderId String          @unique
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])

  status MaterialReservationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  createdBy String?

  /// Preenchidos quando a reserva e liberada (ex.: cancelamento da OP
  /// RELEASED) — nunca por desreserva manual, nao implementada nesta fase.
  releasedAt    DateTime?
  releasedBy    String?
  releaseReason String?

  lines MaterialReservationLine[]

  @@index([status])
  @@map("material_reservations")
}

/// Alocacao oficial por item/lote de uma reserva — base do futuro Picking.
/// Item sem controle de lote: lotId null, quantidade no nivel do Item.
model MaterialReservationLine {
  id String @id @default(uuid())

  reservationId String
  reservation   MaterialReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  productionOrderRequirementId String
  productionOrderRequirement   ProductionOrderRequirement @relation(fields: [productionOrderRequirementId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Null quando o item nao controla lote.
  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  quantity Decimal @db.Decimal(18, 6)

  /// Confirmacao fisica (Picking) desta linha — nunca cria
  /// InventoryMovement, nunca recalcula/reserva de novo. So pode ser
  /// confirmada uma vez; sem partial picking nesta fase (confirma a linha
  /// inteira).
  pickedAt DateTime?
  pickedBy String?

  /// Preenchidos quando esta linha e substituida no Picking (lote
  /// diferente do reservado, escolhido explicitamente pelo operador) —
  /// nunca apagada, so marcada como liberada. Reserved considera so linhas
  /// com releasedAt null.
  releasedAt    DateTime?
  releasedBy    String?
  releaseReason String?

  /// Self-relacao: a linha NOVA de uma substituicao aponta para a linha
  /// ORIGINAL que ela substitui — preserva a genealogia completa (nunca
  /// sobrescreve lotId apagando o lote originalmente reservado).
  replacesLineId String?                  @unique
  replacesLine   MaterialReservationLine? @relation("ReservationLineSubstitution", fields: [replacesLineId], references: [id])
  replacedByLine MaterialReservationLine? @relation("ReservationLineSubstitution")

  createdAt DateTime @default(now())

  consumptions ProductionConsumption[]

  @@index([itemId])
  @@index([lotId])
  @@index([reservationId])
  @@map("material_reservation_lines")
}

/// Evento REAL e imutavel de consumo de material — nunca editado/deletado.
/// Consumo pode ser parcial e acontecer varias vezes para a mesma
/// ReservationLine, ate o limite do que foi reservado (nunca overconsumption
/// nesta fase). Gera exatamente 1 InventoryMovement PRODUCTION_CONSUMPTION
/// (relacao 1:1 garantida — ver InventoryMovement.productionConsumptionId).
model ProductionConsumption {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])

  productionOrderRequirementId String
  productionOrderRequirement   ProductionOrderRequirement @relation(fields: [productionOrderRequirementId], references: [id])

  /// Exige Picking confirmado nesta linha antes do primeiro consumo.
  reservationLineId String
  reservationLine   MaterialReservationLine @relation(fields: [reservationLineId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Null quando o item nao controla lote.
  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  quantity Decimal @db.Decimal(18, 6)

  consumedAt DateTime
  consumedBy String?

  createdAt DateTime @default(now())

  inventoryMovement InventoryMovement?

  @@index([productionOrderId])
  @@index([reservationLineId])
  @@index([itemId])
  @@map("production_consumptions")
}

/// Evento REAL e imutavel de producao parcial — nunca editado/deletado.
/// Uma OP pode ter varios (producao parcial e o comportamento normal).
/// producedQuantity da OP e sempre a soma destes, nunca uma segunda
/// coluna. Gera exatamente 1 InventoryMovement FINISHED_GOOD_PRODUCTION
/// (relacao 1:1 garantida — ver InventoryMovement.productionOutputId).
model ProductionOutput {
  id String @id @default(uuid())

  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])

  /// Nulo so se o Finished Product Item nao controlar lote — bloqueado no
  /// service nesta fase (rastreabilidade do MVP pressupoe lote de produto
  /// acabado), mantido nullable no schema por simetria com os demais
  /// movimentos que tambem preveem item sem lote.
  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  quantity Decimal @db.Decimal(18, 6)

  producedAt DateTime
  producedBy String?
  notes      String?

  createdAt DateTime @default(now())

  inventoryMovement InventoryMovement?

  @@index([productionOrderId])
  @@index([lotId])
  @@map("production_outputs")
}

/// Demanda comercial do Cliente — nunca fonte de verdade de estoque/producao
/// por si so. DRAFT livremente editavel; CONFIRMED congela cliente/produtos/
/// quantidades via snapshot (mesmo padrao de Ordem de Compra) e habilita o
/// Plano de Atendimento; IN_FULFILLMENT ocorre quando o Plano e aplicado
/// (reserva de Produto Acabado + OPs DRAFT geradas). Sem exclusao fisica.
model CustomerOrder {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, PED-000001).
  /// Imutavel apos a criacao.
  code String @unique

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  orderDate             DateTime  @default(now())
  requestedDeliveryDate DateTime?

  status CustomerOrderStatus @default(DRAFT)
  notes  String?

  /// Snapshot historico — preenchido so ao confirmar. Enquanto DRAFT, o
  /// service le Customer ao vivo via join (mesmo padrao de OP/OC).
  customerCode      String?
  customerName      String?
  customerTradeName String?
  customerCnpj      String?
  /// Endereco congelado no CONFIRM: editar o cadastro do Cliente depois
  /// nunca muda o que este documento diz. Pedidos confirmados antes da
  /// capacidade 33 permanecem com null.
  customerStreet     String?
  customerNumber     String?
  customerComplement String?
  customerDistrict   String?
  customerZipCode    String?
  customerCity       String?
  customerState      String?

  confirmedAt DateTime?
  confirmedBy String?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines            CustomerOrderLine[]
  reservations     CustomerOrderReservation[]
  productionOrders ProductionOrder[]
  purchaseOrders   PurchaseOrder[]
  shipments        Shipment[]
  billings         Billing[]

  @@index([status])
  @@index([customerId])
  @@map("customer_orders")
}

/// Linha do Pedido — um Product por Pedido (garantido no banco). DRAFT:
/// substituida em bloco (delete+recreate) a cada save, mesmo padrao de
/// Ordem de Compra/Formulacao. CONFIRMED: congela via snapshot, imutavel.
model CustomerOrderLine {
  id String @id @default(uuid())

  customerOrderId String
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  orderedQuantity Decimal @db.Decimal(18, 6)
  unitCode        String

  /// Ordem de exibicao estavel.
  position Int

  /// Snapshot historico — preenchido so ao confirmar o Pedido.
  productCode      String?
  productName      String?
  finishedItemId   String?
  finishedItemCode String?
  finishedItemName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservationLines CustomerOrderReservationLine[]
  productionOrders ProductionOrder[]
  shipmentLines    ShipmentLine[]
  billingLines     BillingLine[]

  @@unique([customerOrderId, productId])
  @@map("customer_order_lines")
}

/// Reserva de PRODUTO ACABADO por Pedido — contexto proprio, nunca reaproveita
/// MaterialReservation (materia-prima/embalagem de OP). Criada so ao aplicar
/// o Plano de Atendimento. Nunca cria InventoryMovement.
model CustomerOrderReservation {
  id String @id @default(uuid())

  customerOrderId String
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id])

  status CustomerOrderReservationStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  createdBy String?

  releasedAt    DateTime?
  releasedBy    String?
  releaseReason String?

  lines CustomerOrderReservationLine[]

  @@index([customerOrderId])
  @@index([status])
  @@map("customer_order_reservations")
}

/// Alocacao oficial por item/lote de produto acabado de uma reserva de
/// Pedido — soma-se a `MaterialReservationLine` no calculo central de
/// Reserved em `inventory-ledger.ts` (nunca um segundo calculo paralelo).
/// Lote nulo so quando o Finished Product Item nao controla lote (mesmo
/// padrao de MaterialReservationLine).
model CustomerOrderReservationLine {
  id String @id @default(uuid())

  reservationId String
  reservation   CustomerOrderReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  customerOrderLineId String
  customerOrderLine   CustomerOrderLine @relation(fields: [customerOrderLineId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  quantity Decimal @db.Decimal(18, 6)

  /// Preenchidos quando o remanescente desta linha e realocado para outro
  /// lote (ex.: lote venceu antes da expedicao) — nunca apagada, so
  /// marcada. Reserved considera so linhas com releasedAt null; o que ja
  /// foi expedido continua referenciando esta linha historica.
  releasedAt    DateTime?
  releasedBy    String?
  releaseReason String?

  /// Self-relacao: a linha NOVA de uma realocacao aponta para a ORIGINAL
  /// que ela substitui. Diferente de MaterialReservationLine (substituicao
  /// 1:1 no Picking), aqui e 1:N — o remanescente pode ser dividido em
  /// varios lotes pelo allocation service.
  replacesLineId  String?
  replacesLine    CustomerOrderReservationLine?  @relation("CustomerReservationLineSubstitution", fields: [replacesLineId], references: [id])
  replacedByLines CustomerOrderReservationLine[] @relation("CustomerReservationLineSubstitution")

  createdAt DateTime @default(now())

  shipmentLines ShipmentLine[]

  @@index([itemId])
  @@index([lotId])
  @@map("customer_order_reservation_lines")
}

/// Expedicao (saida fisica de produto acabado de um Pedido). DRAFT e so
/// separacao — nunca altera estoque nem conta como expedido. CONFIRMED e a
/// realidade fisica: gera exatamente 1 InventoryMovement SHIPMENT_OUT por
/// linha e e historico imutavel (nunca cancelavel nesta fase). No maximo
/// uma DRAFT ativa por Pedido (garantido por indice parcial na migration).
model Shipment {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, EXP-000001).
  /// Imutavel apos a criacao.
  code String @unique

  customerOrderId String
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id])

  status ShipmentStatus @default(DRAFT)

  /// Preenchida na confirmacao — data da saida fisica real.
  shipmentDate DateTime?
  notes        String?

  confirmedAt DateTime?
  confirmedBy String?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines    ShipmentLine[]
  billings Billing[]

  @@index([customerOrderId])
  @@index([status])
  @@map("shipments")
}

/// Linha de expedicao — sempre ligada a uma CustomerOrderReservationLine
/// especifica (so se expede o que esta reservado AO MESMO Pedido, nunca
/// estoque livre/reserva de outro Pedido/reserva de material de producao).
/// Snapshot preenchido na confirmacao, para leitura historica e base do
/// futuro Faturamento (que se baseia no realmente expedido).
model ShipmentLine {
  id String @id @default(uuid())

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  customerOrderLineId String
  customerOrderLine   CustomerOrderLine @relation(fields: [customerOrderLineId], references: [id])

  customerOrderReservationLineId String
  customerOrderReservationLine   CustomerOrderReservationLine @relation(fields: [customerOrderReservationLineId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  /// Nullable por simetria com as demais linhas do sistema, mas o service
  /// exige lote real — Finished Product do MVP sempre controla lote.
  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  quantity Decimal @db.Decimal(18, 6)
  unitCode String

  /// Ordem de exibicao estavel.
  position Int

  /// Snapshot historico — preenchido so na confirmacao.
  productCode       String?
  productName       String?
  finishedItemCode  String?
  finishedItemName  String?
  lotCode           String?
  businessLotNumber String?

  /// Conferencia fisica do lote antes da saida. Auditoria minima: NAO e um
  /// ScanEvent generico, nao cria movimento e nao altera saldo — so registra
  /// que o lote reservado foi encontrado fisicamente. Uma linha loteada com
  /// quantidade > 0 so pode ser confirmada com `verifiedAt` preenchido.
  verifiedAt DateTime?
  verifiedBy String?

  createdAt DateTime @default(now())

  inventoryMovement InventoryMovement?
  billingLines      BillingLine[]

  @@index([shipmentId])
  @@index([customerOrderLineId])
  @@index([customerOrderReservationLineId])
  @@index([lotId])
  @@map("shipment_lines")
}

/// Documento de faturamento COMERCIAL de uma Expedicao confirmada. Reflete
/// SEMPRE o que foi realmente expedido (ShipmentLine de Shipment
/// CONFIRMED), nunca o pedido/reservado/planejado/produzido. No FAST MVP
/// cada Expedicao e faturada integralmente por um Billing — faturamento
/// parcial dentro da mesma Expedicao e evolucao futura explicita. No
/// maximo um Billing ativo (DRAFT/ISSUED) por Expedicao, garantido por
/// indice unico parcial na migration. Nunca gera InventoryMovement: a
/// saida fisica ja aconteceu no SHIPMENT_OUT da propria Expedicao.
model Billing {
  id String @id @default(uuid())

  /// Codigo interno gerado pelo backend (sequence dedicada, FAT-000001).
  /// Imutavel apos a criacao.
  code String @unique

  customerOrderId String
  customerOrder   CustomerOrder @relation(fields: [customerOrderId], references: [id])

  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id])

  status BillingStatus @default(DRAFT)

  /// Referencia livre a documento externo/ERP/fiscal quando existir
  /// (ex.: "NF 12345") — o sistema nunca valida nem emite essa NF.
  externalReference String?
  notes             String?

  /// Snapshot historico do cliente/documentos de origem, congelado na
  /// criacao — reaproveita os snapshots ja existentes em CustomerOrder/
  /// Shipment, nunca um framework generico.
  customerCode      String?
  customerName      String?
  customerTradeName String?
  customerCnpj      String?
  customerOrderCode String?
  shipmentCode      String?
  shipmentDate      DateTime?

  issuedAt DateTime?
  issuedBy String?

  cancelledAt  DateTime?
  cancelledBy  String?
  cancelReason String?

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines BillingLine[]

  @@index([customerOrderId])
  @@index([shipmentId])
  @@index([status])
  @@index([issuedAt])
  @@map("billings")
}

/// Linha de faturamento — copia fiel de uma ShipmentLine confirmada. A
/// quantidade NUNCA e recalculada a partir do Pedido nem editavel pelo
/// frontend; so `unitPrice` e editavel enquanto DRAFT. `lineTotal` nunca e
/// persistido — sempre derivado (`quantity x unitPrice`) com Decimal.
model BillingLine {
  id String @id @default(uuid())

  billingId String
  billing   Billing @relation(fields: [billingId], references: [id], onDelete: Cascade)

  shipmentLineId String
  shipmentLine   ShipmentLine @relation(fields: [shipmentLineId], references: [id])

  customerOrderLineId String
  customerOrderLine   CustomerOrderLine @relation(fields: [customerOrderLineId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  lotId String?
  lot   Lot?    @relation(fields: [lotId], references: [id])

  /// Snapshot historico — congelado na criacao do Billing.
  productCode       String
  productName       String
  itemCode          String
  itemName          String
  lotCode           String?
  businessLotNumber String?

  /// Identica a ShipmentLine.quantity — nunca recalculada, nunca editavel.
  quantity Decimal @db.Decimal(18, 6)
  unitCode String

  /// Opcional: o MVP nao possui preco comercial confiavel no Pedido, entao
  /// o faturamento quantitativo vale mesmo sem preco. Nunca inferido de
  /// PurchaseOrder (custo != preco de venda). BRL quando informado.
  unitPrice Decimal? @db.Decimal(14, 4)

  /// Ordem de exibicao estavel.
  position Int

  createdAt DateTime @default(now())

  @@index([billingId])
  @@index([shipmentLineId])
  @@index([customerOrderLineId])
  @@map("billing_lines")
}
