# dependencias
node_modules/
.pnpm-store/

# build
dist/
build/
*.tsbuildinfo

# ambiente / segredos
.env
.env.*
!.env.example
# Configuracao de build do frontend, sem segredo — ver cabecalho do arquivo.
!.env.production

# prisma
apps/api/prisma/*.db
apps/api/prisma/*.db-journal

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# cache de ferramentas
.vite/
.cache/
coverage/

# editores / SO
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Dados reais das planilhas Veridi (clientes, CNPJ, formulacoes, precos).
# Nunca versionar.
.local-data/

# Anexos enviados pelo sistema (laudos, NF, artes) — nunca versionados.
uploads/

# Pacote de handoff e screenshots gerados localmente — as telas capturadas
# com a base DEV mostram dados reais de cliente/produto.
handoff/

# Guia comercial em DOCX — material do Product Owner, mantido fora do Git
# de propósito. Entrou uma vez por um `git add docs/` distraído; a linha
# abaixo é para não entrar de novo.
docs/*.docx

# Artefatos de execução: temporário de sessão, estado de suíte, saída de
# ferramenta. Nada disso é fonte — é o que sobra depois de rodar, e já entrou
# no repositório por engano mais de uma vez. `handoff/` cobre o resto.
scripts/_*.sh
**/tmp-*.mjs
**/tmp-*.py
*.state.json
*-state.json
*-log.json
*.pdf

# Capturas do smoke de produção. São telas autenticadas do ambiente real:
# carregam nome de cliente, pedido e lote. O script as escreve na raiz do
# repositório, a um `git add -A` distraído de virarem públicas — a mesma
# distração que já trouxe o DOCX acima para dentro do Git uma vez.
/prod-*.png
